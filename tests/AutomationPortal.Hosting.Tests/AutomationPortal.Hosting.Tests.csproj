<Project Sdk="Microsoft.NET.Sdk">
  <!-- Hosts the engine the way a non-WPF app does: no UseWPF, no AutomationPortal.Host.Wpf. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);NU1603;NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AutomationPortal.Core\AutomationPortal.Core.csproj" />
    <ProjectReference Include="..\..\src\AutomationPortal.Actions.Content\AutomationPortal.Actions.Content.csproj" />
    <ProjectReference Include="..\..\src\AutomationPortal.Actions.Documents\AutomationPortal.Actions.Documents.csproj" />
    <ProjectReference Include="..\..\src\AutomationPortal.Actions.Windows\AutomationPortal.Actions.Windows.csproj" />
    <ProjectReference Include="..\..\src\AutomationPortal.Triggers\AutomationPortal.Triggers.csproj" />
    <ProjectReference Include="..\..\src\AutomationPortal.Ai.Windows\AutomationPortal.Ai.Windows.csproj" />
  </ItemGroup>
</Project>
