<UserControl x:Class="AutomationPortal.App.Pages.RunHistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AutomationPortal.App"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Focusable="False" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="32,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{local:Str RunHistoryPage_RunHistory}" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource SecondaryText}" Margin="2,2,0,0" />
                <TextBlock x:Name="TimeSavedText" Style="{StaticResource SecondaryText}" Margin="2,2,0,0" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ui:TextBox x:Name="FilterBox" Width="200" PlaceholderText="{local:Str RunHistoryPage_SearchByName}" Icon="{ui:SymbolIcon Search20}" TextChanged="OnFilterChanged" />
                <ComboBox x:Name="StatusBox" Width="150" Margin="8,0,0,0" SelectionChanged="OnStatusChanged" AutomationProperties.Name="{local:Str RunHistoryPage_ShowRunsThat_Name}" />
                <ComboBox x:Name="SourceBox" Width="190" Margin="8,0,0,0" SelectionChanged="OnStatusChanged" AutomationProperties.Name="{local:Str RunHistoryPage_ShowRunsStartedBy_Name}" />
                <ui:Button x:Name="ClearButton" Margin="8,0,0,0" Icon="{ui:SymbolIcon MoreHorizontal24}" Click="OnMore" ToolTip="{local:Str RunHistoryPage_More_Tip}" AutomationProperties.Name="{local:Str RunHistoryPage_MoreClearHistory_Name}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid x:Name="ContentGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" MinWidth="280" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ListBox x:Name="RunList" BorderThickness="0" Background="Transparent" SelectionChanged="OnRunSelected"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{local:Str RunHistoryPage_Runs_Name}">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Margin="12,10,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemContainerStyle><StaticResource ResourceKey="FlowListItem" /></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="{Binding StatusSymbol}" FontSize="22" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding When}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="{Binding SourceSymbol}" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" ToolTip="{Binding SourceText}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Duration}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- details -->
                <Border x:Name="DetailsCard" Grid.Column="2" Style="{StaticResource SurfaceCard}" Padding="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DetailsPanel" Margin="22,18,22,22" />
                    </ScrollViewer>
                </Border>
            </Grid>

            <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                <Border Width="84" Height="84" CornerRadius="24" HorizontalAlignment="Center" Background="{DynamicResource FlowEmptyGradient}">
                    <ui:SymbolIcon Symbol="History24" FontSize="42" Foreground="{DynamicResource FlowChipForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="EmptyTitle" Text="{local:Str RunHistoryPage_NothingHasRunYet2}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,6" />
                <TextBlock x:Name="EmptyText" Text="{local:Str RunHistoryPage_WhenYouRunA2}"
                           Style="{StaticResource SecondaryText}" TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
