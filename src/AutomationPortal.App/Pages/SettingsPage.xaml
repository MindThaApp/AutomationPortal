<UserControl x:Class="AutomationPortal.App.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AutomationPortal.App"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:AutomationPortal.App.Controls"
             Focusable="False" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <UserControl.Resources>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="CardDescription" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="SettingCard" TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="SettingsStack" Margin="32,20,32,32" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="{local:Str SettingsPage_Settings}" Style="{StaticResource PageTitle}" />
            <ItemsControl x:Name="SectionJump" Margin="0,0,0,4" AutomationProperties.Name="{local:Str SettingsPage_JumpToASection_Name}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>


            <!-- General -->
            <TextBlock Text="{local:Str SettingsPage_General}" x:Name="SecGeneral" Style="{StaticResource SectionTitle}" />
            <ui:CardControl Style="{StaticResource SettingCard}" Icon="{ui:SymbolIcon WindowApps24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{local:Str SettingsPage_StartWithWindows}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{local:Str SettingsPage_OpenAutomationPortalQuietly}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="StartToggle" Click="OnStartToggle" AutomationProperties.Name="{local:Str SettingsPage_StartWithWindows_Name}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource SettingCard}" Icon="{ui:SymbolIcon ArrowMinimize24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{local:Str SettingsPage_KeepRunningInThe}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{local:Str SettingsPage_WhenYouCloseThe}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="TrayToggle" Click="OnTrayToggle" AutomationProperties.Name="{local:Str SettingsPage_KeepRunningInThe_Name}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource SettingCard}" Icon="{ui:SymbolIcon PaintBrush24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{local:Str SettingsPage_Theme}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{local:Str SettingsPage_ChooseLightOrDark}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="ThemeBox" Width="190" SelectionChanged="OnThemeChanged" AutomationProperties.Name="{local:Str SettingsPage_Theme_Name}">
                    <ComboBoxItem Content="{local:Str SettingsPage_SameAsWindows}" Tag="System" />
                    <ComboBoxItem Content="{local:Str SettingsPage_Light}" Tag="Light" />
                    <ComboBoxItem Content="{local:Str SettingsPage_Dark}" Tag="Dark" />
                </ComboBox>
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource SettingCard}" Icon="{ui:SymbolIcon Square24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{local:Str SettingsPage_ShortcutTiles}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{local:Str SettingsPage_NeutralCardsWithA}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="TileStyleBox" Width="190" SelectionChanged="OnTileStyleChanged" AutomationProperties.Name="{local:Str SettingsPage_ShortcutTileStyle_Name}">
                    <ComboBoxItem Content="{local:Str SettingsPage_Neutral}" Tag="Neutral" />
                    <ComboBoxItem Content="{local:Str SettingsPage_Gradients}" Tag="Gradients" />
                </ComboBox>
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource SettingCard}" Icon="{ui:SymbolIcon Location24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{local:Str SettingsPage_WhereIAm}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{local:Str SettingsPage_UsedForSunriseAnd}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel HorizontalAlignment="Right">
                  <StackPanel Orientation="Horizontal">
                    <ui:TextBox x:Name="HomeCityBox" Width="130" PlaceholderText="{local:Str SettingsPage_CityOptional}" AutomationProperties.Name="{local:Str SettingsPage_HomeCity_Name}" LostFocus="OnHomeChanged" />
                    <StackPanel x:Name="CoordinatesPanel" Orientation="Horizontal" Visibility="Collapsed">
                      <ui:TextBox x:Name="HomeLatBox" Width="90" Margin="6,0,0,0" PlaceholderText="{local:Str SettingsPage_Latitude}" AutomationProperties.Name="{local:Str SettingsPage_HomeLatitudeFromMinus_Name}" LostFocus="OnHomeChanged" />
                      <ui:TextBox x:Name="HomeLonBox" Width="90" Margin="6,0,0,0" PlaceholderText="{local:Str SettingsPage_Longitude}" AutomationProperties.Name="{local:Str SettingsPage_HomeLongitudeFromMinus_Name}" LostFocus="OnHomeChanged" />
                    </StackPanel>
                    <ui:Button x:Name="UseLocationButton" Content="{local:Str SettingsPage_UseMyCurrentLocation}" Margin="6,0,0,0" Click="OnUseLocation" AutomationProperties.Name="{local:Str SettingsPage_UseMyCurrentLocation_Name}" />
                    <ui:Button x:Name="EnterCoordinatesButton" Content="{local:Str SettingsPage_EnterCoordinatesInstead}" Appearance="Transparent" Margin="6,0,0,0" Click="OnEnterCoordinates" AutomationProperties.Name="{local:Str SettingsPage_EnterCoordinatesInstead_Name}" />
                  </StackPanel>
                  <TextBlock x:Name="HomeProblem" Visibility="Collapsed" TextWrapping="Wrap" MaxWidth="460" HorizontalAlignment="Right" FontSize="13" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,4,0,0" AutomationProperties.Name="{local:Str SettingsPage_LocationProblem_Name}" />
                </StackPanel>
            </ui:CardControl>

            <StackPanel x:Name="PlanHost" />

            <!-- Keyboard -->
            <TextBlock Text="{local:Str SettingsPage_Keyboard}" x:Name="SecKeyboard" Style="{StaticResource SectionTitle}" />
            <ui:CardControl Style="{StaticResource SettingCard}" Icon="{ui:SymbolIcon Search24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{local:Str SettingsPage_QuickRun}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{local:Str SettingsPage_PressTheseKeysAnywhere}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel HorizontalAlignment="Right"><ctl:HotkeyRecorderBox x:Name="QuickRunKey" Width="220" ValueChanged="OnQuickRunKey" /><TextBlock x:Name="QuickRunKeyProblem" Visibility="Collapsed" TextWrapping="Wrap" MaxWidth="260" FontSize="13" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,4,0,0" /></StackPanel>
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource SettingCard}" Icon="{ui:SymbolIcon ClipboardTextEdit24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{local:Str SettingsPage_RunOnSelectedText}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{local:Str SettingsPage_SelectSomeTextIn}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel HorizontalAlignment="Right"><ctl:HotkeyRecorderBox x:Name="SelectionKey" Width="220" ValueChanged="OnSelectionKey" /><TextBlock x:Name="SelectionKeyProblem" Visibility="Collapsed" TextWrapping="Wrap" MaxWidth="260" FontSize="13" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,4,0,0" /></StackPanel>
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource SettingCard}" Icon="{ui:SymbolIcon Cursor24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{local:Str SettingsPage_QuickPanelAtThe}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{local:Str SettingsPage_PressTheseKeysTo}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel HorizontalAlignment="Right"><ctl:HotkeyRecorderBox x:Name="PanelKey" Width="220" ValueChanged="OnPanelKey" /><TextBlock x:Name="PanelKeyProblem" Visibility="Collapsed" TextWrapping="Wrap" MaxWidth="260" FontSize="13" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,4,0,0" /></StackPanel>
            </ui:CardControl>

            <!-- Library -->
            <TextBlock Text="{local:Str SettingsPage_LibraryAndBackup}" x:Name="SecLibrary" Style="{StaticResource SectionTitle}" />
            <ui:CardControl Style="{StaticResource SettingCard}" Icon="{ui:SymbolIcon Folder24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{local:Str SettingsPage_WhereYourShortcutsAre}" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="LibraryPathText" Style="{StaticResource CardDescription}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="{local:Str SettingsPage_Open}" AutomationProperties.Name="{local:Str SettingsPage_Open_Name}" Click="OnOpenLibrary" ToolTip="{local:Str SettingsPage_ShowTheFolderIn_Tip}" />
                    <ui:Button Content="{local:Str SettingsPage_CHange}" AutomationProperties.Name="{local:Str SettingsPage_Change_Name}" Margin="8,0,0,0" Click="OnChangeLibrary" />
                </StackPanel>
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource SettingCard}" Icon="{ui:SymbolIcon Cloud24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{local:Str SettingsPage_KeepYourShortcutsIn}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{local:Str SettingsPage_CopiesYourLibraryInto}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="{local:Str SettingsPage_MoveToOneDrive}" AutomationProperties.Name="{local:Str SettingsPage_MoveToOneDrive_Name}" Click="OnMoveToOneDrive" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource SettingCard}" Icon="{ui:SymbolIcon Archive24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{local:Str SettingsPage_BackUpYourLibrary}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{local:Str SettingsPage_SavesYourShortcutsFolders}" Style="{StaticResource CardDescription}" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="{local:Str SettingsPage_BackUpLibraryNow}" AutomationProperties.Name="{local:Str SettingsPage_BackUpLibraryNow_Name}" Click="OnBackUpLibrary" />
                    <ui:Button Content="{local:Str SettingsPage_RestoreFromABackup}" AutomationProperties.Name="{local:Str SettingsPage_RestoreFromABackup_Name}" Click="OnRestoreBackup" Margin="8,0,0,0" ToolTip="{local:Str SettingsPage_AddsTheShortcutsIn_Tip}" />
                </StackPanel>
            </ui:CardControl>

            <!-- Notifications -->
            <TextBlock Text="{local:Str SettingsPage_Notifications}" x:Name="SecNotifications" Style="{StaticResource SectionTitle}" />
            <ui:CardControl Style="{StaticResource SettingCard}" Icon="{ui:SymbolIcon Alert24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{local:Str SettingsPage_TellMeWhenA}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{local:Str SettingsPage_ShowsASmallNotification}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="NotifyToggle" Click="OnNotifyToggle" AutomationProperties.Name="{local:Str SettingsPage_NotifyWhenShortcutsStarted_Name}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource SettingCard}" Icon="{ui:SymbolIcon Speaker224}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{local:Str SettingsPage_PlayASoundWhen}" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="SoundDescription" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="SoundToggle" Click="OnSoundToggle" AutomationProperties.Name="{local:Str SettingsPage_PlayASoundWhen_Name}" />
            </ui:CardControl>
            

            <ui:CardControl Style="{StaticResource SettingCard}" Icon="{ui:SymbolIcon Phone24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{local:Str SettingsPage_PhoneNotificationsTopic}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{local:Str SettingsPage_UsedBySendTo}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:TextBox x:Name="TopicBox" AutomationProperties.Name="{local:Str SettingsPage_PhoneNotificationsTopic_Name}" Width="240" PlaceholderText="{local:Str SettingsPage_ForExampleMyAutomationportal}" TextChanged="OnTopicChanged" />
            </ui:CardControl>

            <!-- Links -->
            <TextBlock Text="{local:Str SettingsPage_OtherAppsAndLinks}" x:Name="SecApps" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="{local:Str SettingsPage_Links}" FontWeight="SemiBold" Margin="0,10,0,6" />
            <ui:CardControl Style="{StaticResource SettingCard}" Icon="{ui:SymbolIcon Link24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{local:Str SettingsPage_AutomationportalLinks}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{local:Str SettingsPage_WebPagesAndOther}" Style="{StaticResource CardDescription}" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="LinksModeBox" MinWidth="170" SelectionChanged="OnLinksModeChanged" AutomationProperties.Name="{local:Str SettingsPage_WhatAutomationportalLinksMay_Name}">
                    <ComboBoxItem Content="{local:Str SettingsPage_Never}" />
                    <ComboBoxItem Content="{local:Str SettingsPage_AskEveryTime}" />
                    <ComboBoxItem Content="{local:Str SettingsPage_PerShortcut}" />
                </ComboBox>
            </ui:CardControl>

            <!-- Connected apps -->
            <TextBlock Text="{local:Str SettingsPage_ConnectedApps}" FontWeight="SemiBold" Margin="0,10,0,6" />
            <StackPanel x:Name="ConnectedHost" />

            <!-- Apps allowed to run shortcuts -->
            <TextBlock Text="{local:Str SettingsPage_AppsAllowedToRun}" FontWeight="SemiBold" Margin="0,10,0,6" />
            <StackPanel x:Name="AllowedCallersHost" />

            <TextBlock Text="{local:Str SettingsPage_Models}" Style="{StaticResource SectionTitle}" x:Name="AiSection" />
            <StackPanel x:Name="AiHost" Margin="0,0,0,6" />

            <ui:CardControl Style="{StaticResource SettingCard}" Icon="{ui:SymbolIcon Brain24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{local:Str SettingsPage_ModelLevelFastSmart}" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="ModelDescription" Style="{StaticResource CardDescription}" TextWrapping="Wrap" />
                        <TextBlock Text="{local:Str SettingsPage_FastCostsLeastAnd}" Style="{StaticResource CardDescription}" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ModelFast" Content="{local:Str SettingsPage_Fast}" GroupName="model" Margin="0,0,4,0" Click="OnModelChanged" Tag="Fast" MinWidth="70" />
                    <RadioButton x:Name="ModelSmart" Content="{local:Str SettingsPage_Smart}" GroupName="model" Margin="0,0,4,0" Click="OnModelChanged" Tag="Smart" MinWidth="70" />
                    <RadioButton x:Name="ModelBest" Content="{local:Str SettingsPage_Best}" GroupName="model" Click="OnModelChanged" Tag="Best" MinWidth="70" />
                </StackPanel>
            </ui:CardControl>

            <!-- Actions -->
            <TextBlock Text="{local:Str SettingsPage_Advanced}" x:Name="SecAdvanced" Style="{StaticResource SectionTitle}" />
            <ui:CardControl Style="{StaticResource SettingCard}" Icon="{ui:SymbolIcon Wrench24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{local:Str SettingsPage_ShowAdvancedActions}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{local:Str SettingsPage_AddsPowerUserActions}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="AdvancedToggle" Click="OnAdvancedToggle" AutomationProperties.Name="{local:Str SettingsPage_ShowAdvancedActions_Name}" />
            </ui:CardControl>
            <ui:CardControl x:Name="CrashReportsCard" Style="{StaticResource SettingCard}" Icon="{ui:SymbolIcon ShieldError24}" Visibility="Collapsed">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{local:Str SettingsPage_SendCrashReportsTo}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{local:Str SettingsPage_IfAutomationPortalCrashes}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="CrashReportsToggle" Click="OnCrashReportsToggle" AutomationProperties.Name="{local:Str SettingsPage_SendCrashReportsTo_Name}" />
            </ui:CardControl>

            <!-- About -->
            <TextBlock Text="{local:Str SettingsPage_About}" x:Name="SecAbout" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource SurfaceCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource FlowEmptyGradient}" Margin="0,0,14,0">
                            <ui:SymbolIcon Symbol="Flash24" FontSize="24" Foreground="{DynamicResource FlowChipForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{local:Str SettingsPage_AutomationPortal}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock x:Name="VersionText" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{local:Str SettingsPage_AutomationPortalWorksOn}" Style="{StaticResource CardDescription}" Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <ui:HyperlinkButton Content="{local:Str SettingsPage_PrivacyPolicy}" NavigateUri="https://mindthaapp.github.io/automation-portal/privacy.html" Margin="0,0,8,0" />
                        <ui:Button Content="{local:Str SettingsPage_OpenDataFolder}" AutomationProperties.Name="{local:Str SettingsPage_OpenDataFolder_Name}" Icon="{ui:SymbolIcon FolderOpen24}" Click="OnOpenData" />
                        <ui:Button Content="{local:Str SettingsPage_OpenLogFolder}" AutomationProperties.Name="{local:Str SettingsPage_OpenLogFolder_Name}" Icon="{ui:SymbolIcon DocumentText24}" Margin="8,0,0,0" Click="OnOpenLogs" />
                        <ui:Button Content="{local:Str SettingsPage_ShowWelcomeAgain}" Icon="{ui:SymbolIcon HandWave24}" Margin="8,0,0,0" Click="OnShowWelcome" AutomationProperties.Name="{local:Str SettingsPage_ShowWelcomeAgain_Name}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>



