<UserControl x:Class="AutomationPortal.App.Pages.AutomationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AutomationPortal.App"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Focusable="False" Foreground="{DynamicResource DsTextPrimaryBrush}">
    <Grid Margin="32,20,8,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,24,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{local:Str AutomationsPage_Automations}" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource SecondaryText}" Margin="2,2,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ui:ToggleSwitch x:Name="PauseToggle" Content="{local:Str AutomationsPage_PauseAllAutomations}" OffContent="Pause all automations" OnContent="Paused" Click="OnPauseToggle" Margin="0,0,16,0"
                                 ToolTip="{local:Str AutomationsPage_StopsEveryAutomationFrom_Tip}" />
                <ui:Button Content="{local:Str AutomationsPage_NewAutomation}" AutomationProperties.Name="{local:Str AutomationsPage_NewAutomation_Name}" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Click="OnNewAutomation" />
            </StackPanel>
        </Grid>

        <Border x:Name="PausedBar" Grid.Row="1" Visibility="Collapsed" Margin="0,0,24,12" Padding="14,10" CornerRadius="{DynamicResource DsRadiusCard}"
                Background="{DynamicResource DsCautionBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource DsStrokeBrush}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="PauseCircle24" FontSize="22" Foreground="{DynamicResource DsCautionBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                <TextBlock Text="{local:Str AutomationsPage_AllAutomationsArePaused}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border x:Name="TestBar" Grid.Row="2" Visibility="Collapsed" Margin="0,0,24,12" Padding="14,10" CornerRadius="{DynamicResource DsRadiusCard}" BorderThickness="1" BorderBrush="{DynamicResource DsStrokeBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon x:Name="TestIcon" Symbol="Info24" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TestTitle" AutomationProperties.LiveSetting="Polite" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="TestMessage" TextWrapping="Wrap" Foreground="{DynamicResource DsTextSecondaryBrush}" />
                </StackPanel>
                <ui:Button x:Name="TestDetails" Grid.Column="2" Content="{local:Str AutomationsPage_SeeDetails}" AutomationProperties.Name="{local:Str AutomationsPage_SeeDetails_Name}" Click="OnTestDetails" Margin="12,0,0,0" Visibility="Collapsed" />
                <ui:Button Grid.Column="3" Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss16}" Click="OnDismissTest" Margin="4,0,0,0" ToolTip="{local:Str AutomationsPage_Dismiss_Tip}" AutomationProperties.Name="{local:Str AutomationsPage_Dismiss_Name}" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,16,24">
            <Grid>
                <StackPanel x:Name="RowsHost" Margin="0,0,8,0" />
                <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,50,24,0" MaxWidth="460">
                    <Border Width="84" Height="84" CornerRadius="24" HorizontalAlignment="Center" Background="{DynamicResource FlowEmptyGradient}">
                        <ui:SymbolIcon Symbol="FlashAuto24" FontSize="42" Foreground="{DynamicResource FlowChipForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{local:Str AutomationsPage_MakeThingsHappenOn}" FontSize="{DynamicResource DsFontSizeSubtitle}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,6" />
                    <TextBlock Text="{local:Str AutomationsPage_AnAutomationRunsA}"
                               Style="{StaticResource SecondaryText}" TextAlignment="Center" />
                    <TextBlock Text="{local:Str AutomationsPage_ForExampleWhenI}" Style="{StaticResource SecondaryText}" TextAlignment="Center" FontStyle="Italic" Margin="0,10,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <ui:Button Content="{local:Str AutomationsPage_NewAutomation2}" AutomationProperties.Name="{local:Str AutomationsPage_NewAutomation_Name}" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Click="OnNewAutomation" />
                        <ui:Button Content="{local:Str AutomationsPage_BrowseTheGallery}" AutomationProperties.Name="{local:Str AutomationsPage_BrowseTheGallery_Name}" Icon="{ui:SymbolIcon Library24}" Margin="10,0,0,0" Click="OnBrowseGallery" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
