<UserControl x:Class="AutomationPortal.App.Pages.LibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:AutomationPortal.App.ViewModels"
             xmlns:ctl="clr-namespace:AutomationPortal.App.Controls"
             Focusable="False" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="32,20,8,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,24,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" Text="All Shortcuts" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource SecondaryText}" Margin="2,2,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ui:Button x:Name="ClearSearchButton" Content="Clear search" Margin="0,0,8,0" Visibility="Collapsed" Click="OnClearSearch"
                           Icon="{ui:SymbolIcon Dismiss20}" />
                <ui:Button x:Name="RecentlyDeletedButton" Content="_Recently deleted" AutomationProperties.Name="Recently deleted" Margin="0,0,8,0" Click="OnRecentlyDeleted" Icon="{ui:SymbolIcon Delete24}"
                           Appearance="Transparent" Visibility="Collapsed" ToolTip="Restore shortcuts you deleted in the last 30 days" />
                <ui:Button x:Name="NewButton" Content="_New shortcut" AutomationProperties.Name="New shortcut" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Click="OnNewShortcut"
                           ToolTip="Create a new shortcut (Ctrl+N)" />
            </StackPanel>
        </Grid>

        <!-- Shown after a run: what it changed with Undo, or why it didn't finish; and after a delete, with Undo -->
        <!-- It has its own row, so showing it pushes the tiles down and no tile is ever covered -->
        <Border x:Name="ResultBar" Grid.Row="2" VerticalAlignment="Top" Visibility="Collapsed" Opacity="0" Margin="0,0,24,12" Padding="14,10" CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Border.RenderTransform><TranslateTransform x:Name="BarSlide" /></Border.RenderTransform>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon x:Name="ResultIcon" Symbol="ErrorCircle24" FontSize="22" Foreground="{DynamicResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="ResultTitle" AutomationProperties.LiveSetting="Polite" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="ResultMessage" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button x:Name="ResultUndo" Content="_Undo" AutomationProperties.Name="Undo" Icon="{ui:SymbolIcon ArrowUndo16}" Click="OnResultUndo" Margin="12,0,0,0" Visibility="Collapsed" />
                    <ui:Button x:Name="ResultHotkey" Content="Give it a hotkey" AutomationProperties.Name="Give it a hotkey" Icon="{ui:SymbolIcon Keyboard24}" Click="OnResultHotkey" Margin="8,0,0,0" Visibility="Collapsed" />
                </StackPanel>
                <ui:Button x:Name="ResultDetails" Grid.Column="3" Content="See _details" AutomationProperties.Name="See details" Click="OnSeeDetails" Margin="8,0,0,0" />
                <ui:Button Grid.Column="4" Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss16}" Click="OnDismissResult" Margin="4,0,0,0" ToolTip="Dismiss" AutomationProperties.Name="Dismiss" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,16,24">
          <StackPanel>
            <!-- Start here: a few ready-made shortcuts from the Gallery -->
            <StackPanel x:Name="StartHerePanel" Visibility="Collapsed" Margin="0,0,0,16">
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Start here" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="See the _Gallery" AutomationProperties.Name="See the Gallery" Appearance="Transparent" Click="OnBrowseGallery" />
                        <ui:Button Content="_Hide" AutomationProperties.Name="Hide" Appearance="Transparent" Click="OnHideStartHere" ToolTip="Hide this row. The Gallery is always in the sidebar." />
                    </StackPanel>
                </Grid>
                <WrapPanel x:Name="StartHereItems" />
            </StackPanel>
            <Grid>
                <ItemsControl x:Name="TileList" AllowDrop="True" DragOver="OnListDragOver" Drop="OnListDrop"
                              KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Continue">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Resources>
                        <DataTemplate DataType="{x:Type vm:ShortcutTileViewModel}">
                            <ctl:ShortcutTile Width="182" Height="140" AllowDrop="True" SelectRequested="OnTileSelect" PreviewRequested="OnTilePreview"
                                              RunRequested="OnTileRun" EditRequested="OnTileEdit" MenuRequested="OnTileMenu"
                                              PreviewMouseLeftButtonDown="OnTileMouseDown" PreviewMouseMove="OnTileMouseMove"
                                              DragOver="OnTileDragOver" DragLeave="OnTileDragLeave" Drop="OnTileDrop" />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:NewShortcutTile}">
                            <Button Width="182" Height="140" Style="{StaticResource PlainTileButton}" Margin="0" Padding="0" Click="OnNewShortcut" AllowDrop="True"
                                    DragOver="OnListDragOver" Drop="OnListDrop" ToolTip="Create a new shortcut" AutomationProperties.Name="New shortcut">
                                <Border Margin="6" CornerRadius="12" BorderThickness="2" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="Transparent">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Add24" FontSize="30" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="New shortcut" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.Resources>
                </ItemsControl>

                <!-- Friendly empty state -->
                <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60,24,0" MaxWidth="440">
                    <Border Width="84" Height="84" CornerRadius="24" HorizontalAlignment="Center" Background="{DynamicResource FlowEmptyGradient}">
                        <ui:SymbolIcon x:Name="EmptyIcon" Symbol="Flash24" FontSize="42" Foreground="{DynamicResource FlowChipForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="EmptyTitle" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,6" TextAlignment="Center" />
                    <TextBlock x:Name="EmptyText" Style="{StaticResource SecondaryText}" TextAlignment="Center" />
                    <WrapPanel x:Name="EmptyButtons" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <ui:Button Content="_Browse the Gallery" AutomationProperties.Name="Browse the Gallery" Appearance="Primary" Icon="{ui:SymbolIcon Library24}" Click="OnBrowseGallery" Margin="5,0,5,8" />
                        <ui:Button Content="_Create a shortcut" AutomationProperties.Name="Create a shortcut" Icon="{ui:SymbolIcon Add24}" Click="OnNewShortcut" Margin="5,0,5,8" />
                        <ui:Button Content="De_scribe it" Icon="{ui:SymbolIcon Sparkle24}" Click="OnDescribeIt" Margin="5,0,5,8"
                                   AutomationProperties.Name="Describe the shortcut you want" ToolTip="Say what you want in a sentence and get a draft" />
                    </WrapPanel>
                </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
