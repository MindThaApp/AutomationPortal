<UserControl x:Class="AutomationPortal.App.Pages.SnippetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AutomationPortal.App"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Focusable="False" Foreground="{DynamicResource DsTextPrimaryBrush}">
    <Grid Margin="32,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{local:Str SnippetsPage_Snippets}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{local:Str SnippetsPage_TypeAShortCode}" Style="{StaticResource SecondaryText}" Margin="2,2,0,0" />
            </StackPanel>
            <ui:Button Content="{local:Str SnippetsPage_NewSnippet}" AutomationProperties.Name="{local:Str SnippetsPage_NewSnippet_Name}" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnNewSnippet" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid x:Name="MainGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" MinWidth="260" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="SearchBox" PlaceholderText="{local:Str SnippetsPage_SearchSnippets}" Icon="{ui:SymbolIcon Search20}" TextChanged="OnFilterChanged" />
                        <ComboBox x:Name="FolderFilter" Grid.Column="1" Width="130" Margin="8,0,0,0" SelectionChanged="OnFolderFilterChanged" AutomationProperties.Name="{local:Str SnippetsPage_Folder_Name}" />
                    </Grid>
                    <ListBox x:Name="SnippetList" Grid.Row="1" BorderThickness="0" Background="Transparent" SelectionChanged="OnSnippetSelected"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{local:Str SnippetsPage_Snippets_Name}">
                        <ListBox.ItemContainerStyle><StaticResource ResourceKey="FlowListItem" /></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Abbreviation}" FontWeight="SemiBold" FontFamily="Consolas" FontSize="{DynamicResource DsFontSizeBody}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Preview}" FontSize="{DynamicResource DsFontSizeReadable}" Foreground="{DynamicResource DsTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Folder}" FontSize="{DynamicResource DsFontSizeReadable}" Foreground="{DynamicResource DsTextTertiaryBrush}" Visibility="{Binding FolderVisibility}" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" ToolTip="{local:Str SnippetsPage_TurnThisSnippetOn_Tip}"
                                                     AutomationProperties.Name="{local:Str SnippetsPage_Enabled_Name}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- editor -->
                <Border Grid.Column="2" Style="{StaticResource SurfaceCard}" Padding="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="EditorPanel" Margin="22,18,22,22">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{local:Str SnippetsPage_ShortCode}" Style="{StaticResource SecondaryText}" FontSize="{DynamicResource DsFontSizeReadable}" Margin="0,0,0,4" />
                                    <ui:TextBox x:Name="AbbrBox" PlaceholderText="{local:Str SnippetsPage_Sig}" FontFamily="Consolas" TextChanged="OnEditorChanged" AutomationProperties.Name="{local:Str SnippetsPage_ShortCode_Name}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{local:Str SnippetsPage_FolderOptional}" Style="{StaticResource SecondaryText}" FontSize="{DynamicResource DsFontSizeReadable}" Margin="0,0,0,4" />
                                    <ComboBox x:Name="FolderBox" IsEditable="True" Text="" AutomationProperties.Name="{local:Str SnippetsPage_Folder_Name}" LostFocus="OnEditorChanged" SelectionChanged="OnEditorChangedSel" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="AbbrError" Visibility="Collapsed" FontSize="{DynamicResource DsFontSizeReadable}" Margin="0,4,0,0" Foreground="{DynamicResource DsCriticalBrush}" TextWrapping="Wrap" />

                            <TextBlock Text="{local:Str SnippetsPage_ReplaceItWith}" Style="{StaticResource SecondaryText}" FontSize="{DynamicResource DsFontSizeReadable}" Margin="0,16,0,4" />
                            <ui:TextBox x:Name="BodyBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="130" VerticalScrollBarVisibility="Auto"
                                        PlaceholderText="{local:Str SnippetsPage_TheTextThatShould}" TextChanged="OnEditorChanged" AutomationProperties.Name="{local:Str SnippetsPage_ReplacementText_Name}" />

                            <TextBlock Text="{local:Str SnippetsPage_AddAPlaceholder}" Style="{StaticResource SecondaryText}" FontSize="{DynamicResource DsFontSizeReadable}" Margin="0,12,0,6" />
                            <WrapPanel>
                                <ui:Button Content="{local:Str SnippetsPage_Date}" Margin="0,0,6,6" Click="OnPlaceholder" Tag="{}{date}" ToolTip="{local:Str SnippetsPage_TodaySDate_Tip}" />
                                <ui:Button Content="{local:Str SnippetsPage_DateFormat2}" Margin="0,0,6,6" Click="OnDateFormat" ToolTip="{local:Str SnippetsPage_TodaySDateIn_Tip}" />
                                <ui:Button Content="{local:Str SnippetsPage_Time}" Margin="0,0,6,6" Click="OnPlaceholder" Tag="{}{time}" ToolTip="{local:Str SnippetsPage_TheCurrentTime_Tip}" />
                                <ui:Button Content="{local:Str SnippetsPage_Clipboard}" Margin="0,0,6,6" Click="OnPlaceholder" Tag="{}{clipboard}" ToolTip="{local:Str SnippetsPage_WhateverYouLastCopied_Tip}" />
                                <ui:Button Content="{local:Str SnippetsPage_CursorSpot}" Margin="0,0,6,6" Click="OnPlaceholder" Tag="{}{cursor}" ToolTip="{local:Str SnippetsPage_WhereTheCursorLands_Tip}" />
                                <ui:Button Content="{local:Str SnippetsPage_AskMe2}" Margin="0,0,6,6" Click="OnFillIn" ToolTip="{local:Str SnippetsPage_AutomationPortalAsksYou_Tip}" />
                            </WrapPanel>

                            <TextBlock Text="{local:Str SnippetsPage_Preview}" Style="{StaticResource SecondaryText}" FontSize="{DynamicResource DsFontSizeReadable}" Margin="0,10,0,4" />
                            <Border CornerRadius="{DynamicResource DsRadiusCard}" Padding="12,10" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{DynamicResource DsStrokeBrush}">
                                <TextBlock x:Name="PreviewText" TextWrapping="Wrap" MinHeight="20" />
                            </Border>

                            <ui:ToggleSwitch x:Name="MatchCaseToggle" Content="{local:Str SnippetsPage_MatchCapitalLettersExactly}" Margin="0,16,0,0" Click="OnEditorToggle" />
                            <TextBlock Text="{local:Str SnippetsPage_WhenThisIsOff}" Style="{StaticResource SecondaryText}" FontSize="{DynamicResource DsFontSizeReadable}" Margin="0,2,0,0" />

                            <ui:Button Content="{local:Str SnippetsPage_DeleteSnippet2}" AutomationProperties.Name="{local:Str SnippetsPage_DeleteSnippet_Name}" Icon="{ui:SymbolIcon Delete20}" Margin="0,20,0,0" Click="OnDelete" HorizontalAlignment="Left" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                <Border Width="84" Height="84" CornerRadius="24" HorizontalAlignment="Center" Background="{DynamicResource FlowEmptyGradient}">
                    <ui:SymbolIcon Symbol="TextT24" FontSize="42" Foreground="{DynamicResource FlowChipForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{local:Str SnippetsPage_SaveYourselfSomeTyping}" FontSize="{DynamicResource DsFontSizeSubtitle}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,6" />
                <TextBlock Text="{local:Str SnippetsPage_MakeAShortCode}" Style="{StaticResource SecondaryText}" TextAlignment="Center" />
                <ui:Button Content="{local:Str SnippetsPage_AddDateAndAddr}" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" HorizontalAlignment="Center" Margin="0,20,0,0" Click="OnAddStarters" ToolTip="{local:Str SnippetsPage_AddsASnippetFor_Tip}" />
                <ui:Button Content="{local:Str SnippetsPage_CreateYourOwn}" AutomationProperties.Name="{local:Str SnippetsPage_CreateYourOwn_Name}" Appearance="Secondary" HorizontalAlignment="Center" Margin="0,8,0,0" Click="OnNewSnippet" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
