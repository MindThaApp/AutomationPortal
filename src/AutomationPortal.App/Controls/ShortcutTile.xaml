<UserControl x:Class="AutomationPortal.App.Controls.ShortcutTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AutomationPortal.App"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ed="clr-namespace:AutomationPortal.Editor;assembly=AutomationPortal.Editor"
             xmlns:svc="clr-namespace:AutomationPortal.App.Services"
             xmlns:ctl="clr-namespace:AutomationPortal.App.Controls"
             Focusable="False">
    <Grid x:Name="Root" Margin="6" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>

        <!-- Elevation 1 sits behind the card and shows on hover only. -->
        <Border x:Name="Lift" CornerRadius="{DynamicResource DsRadiusCard}" Background="{DynamicResource DsCardBrush}" IsHitTestVisible="False" />

        <ctl:SelectableTileButton x:Name="TileButton" Style="{StaticResource FlowTileButton}"
                ToolTip="{Binding Tooltip}" Click="OnTileClick" MouseDoubleClick="OnTileDoubleClick" AutomationProperties.Name="{Binding AutomationName}">
            <!-- Cards look: icon on top, title below. Compact look: icon and title on one row. DsTileName* tokens (Appearance settings) pick the cell. -->
            <Grid Margin="12,12,12,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Chip" Width="34" Height="34" CornerRadius="{DynamicResource DsRadiusCard}" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <ui:SymbolIcon x:Name="GlyphIcon" Symbol="{Binding Symbol}" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel x:Name="NameStack" Grid.Row="{DynamicResource DsTileNameRow}" Grid.Column="{DynamicResource DsTileNameColumn}" Grid.ColumnSpan="{DynamicResource DsTileNameColumnSpan}"
                            Margin="{DynamicResource DsTileNameMargin}" VerticalAlignment="{DynamicResource DsTileNameVerticalAlignment}" HorizontalAlignment="Left">
                    <TextBlock x:Name="NameText" Text="{Binding Name}" Foreground="{DynamicResource DsTextPrimaryBrush}" FontSize="{DynamicResource DsFontSizeBody}" FontWeight="SemiBold" TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" LineStackingStrategy="BlockLineHeight" LineHeight="{DynamicResource DsTileTitleLineHeight}" MaxHeight="{DynamicResource DsTileTitleMaxHeight}" />
                    <TextBlock x:Name="ProgressLine" Text="{Binding ProgressText}" Foreground="{DynamicResource DsTextSecondaryBrush}" FontSize="{DynamicResource DsFontSizeReadable}" TextTrimming="CharacterEllipsis"
                               Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <ui:SymbolIcon x:Name="PinIcon" Grid.Column="2" Symbol="Pin16" FontSize="12" Foreground="{DynamicResource DsTextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                    <ui:SymbolIcon.Style>
                        <Style TargetType="ui:SymbolIcon">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Pinned}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:SymbolIcon.Style>
                </ui:SymbolIcon>
                <!-- Keeps room for the Run and Edit row that sits over the bottom of the tile -->
                <Border Grid.Row="2" Grid.ColumnSpan="4" Margin="0,6,0,0" Height="{Binding ActualHeight, ElementName=Actions}" IsHitTestVisible="False" />
            </Grid>
        </ctl:SelectableTileButton>

        <!-- Selected: accent tint and an accent border. A click only selects in the library. -->
        <Border x:Name="SelectRing" CornerRadius="{DynamicResource DsRadiusCard}" BorderThickness="2" IsHitTestVisible="False" Visibility="Collapsed"
                Background="{DynamicResource DsSelectionFillBrush}" BorderBrush="{DynamicResource DsAccentBrush}" />

        <!-- Explicit Run and Edit buttons (library tiles) -->
        <Grid x:Name="Actions" VerticalAlignment="Bottom" Margin="12,0,12,10" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:Button x:Name="RunButton" Content="{local:Str ShortcutTile_Run2}" HorizontalAlignment="Stretch" Padding="6,3" FontSize="{DynamicResource DsFontSizeCaption}" Icon="{ui:SymbolIcon Play16}" Click="OnRunClick" AutomationProperties.Name="{local:Str ShortcutTile_Run_Name}" ToolTip="{local:Str ShortcutTile_RunEnter_Tip}" />
            <ui:Button x:Name="EditButton" Grid.Column="2" Content="{local:Str ShortcutTile_Edit}" HorizontalAlignment="Stretch" Padding="6,3" FontSize="{DynamicResource DsFontSizeCaption}" Icon="{ui:SymbolIcon Edit16}" Click="OnEditClick" AutomationProperties.Name="{local:Str ShortcutTile_Edit_Name}" ToolTip="{local:Str ShortcutTile_EditCtrlE_Tip}" />
        </Grid>

        <!-- "..." is always visible (dimmed at rest), full strength on hover or focus -->
        <Button x:Name="MoreButton" Style="{StaticResource GhostIconButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                ToolTip="{local:Str ShortcutTile_MoreOptions_Tip}" Click="OnMoreClick" AutomationProperties.Name="{local:Str ShortcutTile_MoreOptions_Name}" Opacity="0.7">
            <ui:SymbolIcon x:Name="MoreIcon" Symbol="MoreHorizontal24" FontSize="18" Foreground="{DynamicResource DsTextSecondaryBrush}" />
        </Button>

        <!-- Run state: the spinner appears only when a run is still going after a short pause; the tick and the cross are driven from code -->
        <Grid x:Name="SpinnerHost" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,40,0" Width="24" Height="24" IsHitTestVisible="False" Visibility="Collapsed">
            <ui:ProgressRing x:Name="Spinner" IsIndeterminate="True" Width="22" Height="22" Foreground="{DynamicResource DsAccentBrush}" />
        </Grid>
        <Grid x:Name="Badge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,40,0" Width="24" Height="24" IsHitTestVisible="False"
              RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
            <Grid.RenderTransform><ScaleTransform x:Name="BadgeScale" /></Grid.RenderTransform>
            <Border x:Name="SuccessMark" CornerRadius="12" Background="{DynamicResource FlowSuccessBrush}" Visibility="Collapsed">
                <ui:SymbolIcon Symbol="Checkmark20" FontSize="15" Foreground="{DynamicResource FlowChipForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border x:Name="FailMark" CornerRadius="12" Background="{DynamicResource FlowFailBrush}" Visibility="Collapsed">
                <ui:SymbolIcon Symbol="Dismiss20" FontSize="14" Foreground="{DynamicResource FlowChipForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>

        <!-- Drop marker for drag and drop reordering -->
        <Border x:Name="DropMarker" Width="4" CornerRadius="2" HorizontalAlignment="Left" Margin="-7,6,0,6" Visibility="Collapsed" IsHitTestVisible="False"
                Background="{DynamicResource DsAccentBrush}" />
    </Grid>
</UserControl>
