<UserControl x:Class="AutomationPortal.App.Controls.ShortcutTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ed="clr-namespace:AutomationPortal.Editor;assembly=AutomationPortal.Editor"
             xmlns:svc="clr-namespace:AutomationPortal.App.Services"
             Focusable="False">
    <Grid x:Name="Root" Margin="6" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="UIElement.MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.025" Duration="{x:Static ed:Motion.D120}" />
                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.025" Duration="{x:Static ed:Motion.D120}" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="UIElement.MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="{x:Static ed:Motion.D180}" />
                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="{x:Static ed:Motion.D180}" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Button x:Name="TileButton" Style="{StaticResource FlowTileButton}" Background="{Binding Brush}"
                ToolTip="{Binding Tooltip}" Click="OnTileClick" MouseDoubleClick="OnTileDoubleClick" AutomationProperties.Name="{Binding Name}">
            <Grid>
                <Border x:Name="Chip" Width="40" Height="40" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,12,0,0">
                    <ui:SymbolIcon x:Name="GlyphIcon" Symbol="{Binding Symbol}" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="NameText" Text="{Binding Name}" Foreground="White" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" MaxHeight="40" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="14,0,14,12" />
                <ui:SymbolIcon x:Name="PinIcon" Symbol="Pin16" FontSize="12" Foreground="#CCFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,40,12,0">
                    <ui:SymbolIcon.Style>
                        <Style TargetType="ui:SymbolIcon">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Pinned}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:SymbolIcon.Style>
                </ui:SymbolIcon>
            </Grid>
        </Button>

        <!-- Selected: a ring. A click only selects in the library. -->
        <Border x:Name="SelectRing" CornerRadius="12" BorderThickness="2" IsHitTestVisible="False" Visibility="Collapsed"
                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" />

        <!-- Explicit Run and Edit buttons (library tiles) -->
        <StackPanel x:Name="Actions" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,10" Visibility="Collapsed">
            <ui:Button x:Name="RunButton" Content="Run" Appearance="Primary" Padding="12,3" FontSize="12" Icon="{ui:SymbolIcon Play16}" Click="OnRunClick" AutomationProperties.Name="Run" />
            <ui:Button x:Name="EditButton" Content="Edit" Padding="12,3" FontSize="12" Margin="6,0,0,0" Icon="{ui:SymbolIcon Edit16}" Click="OnEditClick" AutomationProperties.Name="Edit" />
        </StackPanel>

        <!-- "..." is always visible (dimmed at rest), full strength on hover or focus -->
        <Button x:Name="MoreButton" Style="{StaticResource GhostIconButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                ToolTip="More options" Click="OnMoreClick" AutomationProperties.Name="More options" Opacity="0.7">
            <ui:SymbolIcon x:Name="MoreIcon" Symbol="MoreHorizontal24" FontSize="18" Foreground="White" />
            <Button.Triggers>
                <EventTrigger RoutedEvent="UIElement.GotKeyboardFocus">
                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="{x:Static ed:Motion.D100}" /></Storyboard></BeginStoryboard>
                </EventTrigger>
            </Button.Triggers>
        </Button>

        <!-- Run state badge -->
        <Grid x:Name="Badge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Width="24" Height="24" IsHitTestVisible="False"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform x:Name="BadgeScale" /></Grid.RenderTransform>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static svc:TileRunState.Running}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static svc:TileRunState.Succeeded}">
                            <Setter Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.3" To="1" Duration="{x:Static ed:Motion.D280}">
                                            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.3" To="1" Duration="{x:Static ed:Motion.D280}">
                                            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static svc:TileRunState.Failed}">
                            <Setter Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.3" To="1" Duration="{x:Static ed:Motion.D280}">
                                            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.3" To="1" Duration="{x:Static ed:Motion.D280}">
                                            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <ui:ProgressRing x:Name="Spinner" IsIndeterminate="True" Width="22" Height="22" Foreground="White">
                <ui:ProgressRing.Style>
                    <Style TargetType="ui:ProgressRing">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static svc:TileRunState.Running}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:ProgressRing.Style>
            </ui:ProgressRing>
            <Border CornerRadius="12" Background="{DynamicResource FlowSuccessBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static svc:TileRunState.Succeeded}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ui:SymbolIcon Symbol="Checkmark20" FontSize="15" Foreground="{DynamicResource FlowChipForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border CornerRadius="12" Background="{DynamicResource FlowFailBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static svc:TileRunState.Failed}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ui:SymbolIcon Symbol="Dismiss20" FontSize="14" Foreground="{DynamicResource FlowChipForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>

        <!-- Drop marker for drag and drop reordering -->
        <Border x:Name="DropMarker" Width="4" CornerRadius="2" HorizontalAlignment="Left" Margin="-7,6,0,6" Visibility="Collapsed" IsHitTestVisible="False"
                Background="{DynamicResource AccentFillColorDefaultBrush}" />
    </Grid>
</UserControl>
