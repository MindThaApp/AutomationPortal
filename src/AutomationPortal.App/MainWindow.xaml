<ui:FluentWindow x:Class="AutomationPortal.App.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AutomationPortal.App"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="{local:Str MainWindow_AutomationPortal}" Width="1180" Height="760" MinWidth="760" MinHeight="520"
                  WindowStartupLocation="CenterScreen"
                  WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True"
                  FontFamily="{StaticResource FlowFont}" Foreground="{DynamicResource DsTextPrimaryBrush}"
                  Icon="pack://application:,,,/Assets/automationportal.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="{local:Str MainWindow_AutomationPortal}" ShowMaximize="True" ShowMinimize="True" CloseWindowByDoubleClickOnIcon="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/automationportal.png" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.CenterContent>
                <ui:AutoSuggestBox x:Name="SearchBox" Width="380" Margin="16,0,0,0" PlaceholderText="{local:Str MainWindow_SearchShortcutsAndThe}"
                                   TextChanged="OnSearchTextChanged" SuggestionChosen="OnSearchChosen" QuerySubmitted="OnSearchSubmitted"
                                   AutomationProperties.Name="{local:Str MainWindow_Search_Name}" ToolTip="{local:Str MainWindow_SearchShortcutsAndThe_Tip}">
                    <ui:AutoSuggestBox.Icon>
                        <ui:SymbolIcon Symbol="Search20" />
                    </ui:AutoSuggestBox.Icon>
                </ui:AutoSuggestBox>
            </ui:TitleBar.CenterContent>
        </ui:TitleBar>

        <ui:NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
                           OpenPaneLength="248" IsPaneToggleVisible="True" TitleBar="{Binding ElementName=TitleBar}" />

        <Border x:Name="UpdateBanner" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,0,16,16"
                Padding="16,10" CornerRadius="8" BorderThickness="1" Background="{DynamicResource DsCardBrush}" BorderBrush="{DynamicResource DsStrokeBrush}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="ArrowDownload24" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource DsAccentBrush}" />
                <TextBlock Text="{local:Str Update_Ready}" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{DynamicResource DsTextPrimaryBrush}" />
                <ui:Button x:Name="UpdateNowButton" Content="{local:Str Update_Update}" Appearance="Primary" Margin="0,0,8,0" Click="OnUpdateNow"
                           ToolTip="{local:Str Update_UpdateTip}" AutomationProperties.HelpText="{local:Str Update_UpdateTip}" />
                <ui:Button x:Name="UpdateLaterButton" Content="{local:Str Update_Later}" Click="OnUpdateLater"
                           ToolTip="{local:Str Update_LaterTip}" AutomationProperties.HelpText="{local:Str Update_LaterTip}" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
