<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <OutputType>WinExe</OutputType>
    <AssemblyName>AutomationPortal</AssemblyName>
    <RootNamespace>AutomationPortal.App</RootNamespace>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\automationportal.ico</ApplicationIcon>
    <NeutralLanguage>en</NeutralLanguage>
    <Product>Automation Portal</Product>
    <AssemblyTitle>Automation Portal</AssemblyTitle>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AutomationPortal.Core\AutomationPortal.Core.csproj" />
    <ProjectReference Include="..\AutomationPortal.Actions.Content\AutomationPortal.Actions.Content.csproj" />
    <ProjectReference Include="..\AutomationPortal.Actions.Windows\AutomationPortal.Actions.Windows.csproj" />
    <ProjectReference Include="..\AutomationPortal.Actions.Documents\AutomationPortal.Actions.Documents.csproj" />
    <ProjectReference Include="..\AutomationPortal.Triggers\AutomationPortal.Triggers.csproj" />
    <ProjectReference Include="..\AutomationPortal.Editor\AutomationPortal.Editor.csproj" />
    <ProjectReference Include="..\AutomationPortal.Ai.Windows\AutomationPortal.Ai.Windows.csproj" />
    <ProjectReference Include="..\AutomationPortal.Host.Wpf\AutomationPortal.Host.Wpf.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\automationportal.ico" />
    <None Remove="Assets\automationportal.png" />
    <Resource Include="Assets\automationportal.png" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\gallery\**\*.*" Link="gallery\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AutomationPortal.App.Tests" />
  </ItemGroup>
</Project>
