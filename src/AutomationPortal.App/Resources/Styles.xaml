<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:ed="clr-namespace:AutomationPortal.Editor;assembly=AutomationPortal.Editor">

    <FontFamily x:Key="FlowFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FlowDisplayFont">Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI</FontFamily>

    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <SolidColorBrush x:Key="FlowChipForeground" Color="White" />
    <!-- One focus ring for every control: 2 px line, 1 px gap (DsFocusVisual in Tokens.xaml). WPF-UI controls read these two keys. -->
    <Style x:Key="DefaultControlFocusVisualStyle" BasedOn="{StaticResource DsFocusVisual}" />
    <Style x:Key="DefaultFocusVisualStyle" BasedOn="{StaticResource DsFocusVisual}" />
    <!-- Hover and press borders: invisible normally, a system-colour border in high contrast (HighContrast.cs swaps them), so state never rests on a fill alone. -->
    <SolidColorBrush x:Key="FlowHoverBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="FlowPressBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="FlowSuccessBrush" Color="{StaticResource DsCategoryGreenColor}" />
    <SolidColorBrush x:Key="FlowFailBrush" Color="{StaticResource DsCategoryRedColor}" />
    <LinearGradientBrush x:Key="FlowEmptyGradient" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="{StaticResource DsCategoryBlueColor}" Offset="0" />
        <GradientStop Color="{StaticResource DsCategoryIndigoColor}" Offset="1" />
    </LinearGradientBrush>

    <!-- Page headline -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FlowDisplayFont}" />
        <Setter Property="FontSize" Value="{DynamicResource DsFontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource DsTextPrimaryBrush}" />
    </Style>

    <Style x:Key="SecondaryText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DsTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource DsFontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource DsTextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,20,0,8" />
    </Style>

    <!-- Rounded surface used by rows and cards -->
    <Style x:Key="SurfaceCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource DsRadiusCard}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource DsCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsStrokeBrush}" />
        <Setter Property="Padding" Value="{DynamicResource DsCardPadding}" />
    </Style>

    <!-- A tile face: a neutral card (card fill, stroke, radius 8). Hover and press add a veil; keyboard focus gets the shared focus ring. -->
    <Style x:Key="FlowTileButton" TargetType="Button">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Background" Value="{DynamicResource DsCardBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DsFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Face" CornerRadius="{DynamicResource DsRadiusCard}" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource DsStrokeBrush}" BorderThickness="1" SnapsToDevicePixels="True" />
                        <Border x:Name="Hover" CornerRadius="{DynamicResource DsRadiusCard}" Background="{DynamicResource DsHoverBrush}" Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="Press" CornerRadius="{DynamicResource DsRadiusCard}" Background="{DynamicResource DsHoverBrush}" Opacity="0" IsHitTestVisible="False" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Press" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Borderless icon-only button for small overlays -->
    <Style x:Key="GhostIconButton" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DsFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="14" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="Ring" CornerRadius="14" BorderThickness="2" BorderBrush="Transparent" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DsOnTileHoverBrush}" />
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource FlowHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DsOnTilePressBrush}" />
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource FlowPressBorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Flat button used by the "+" tile: no card, just a soft highlight -->
    <Style x:Key="PlainTileButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DsFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="12" Background="Transparent" BorderThickness="2" BorderBrush="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DsHoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FlowHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DsPressedBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FlowPressBorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Big pickable card (wizard trigger cards, gallery tiles) -->
    <Style x:Key="BigCardButton" TargetType="Button">
        <Setter Property="Padding" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DsFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="10" BorderThickness="1" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource DsCardBrush}"
                                BorderBrush="{DynamicResource DsStrokeBrush}">
                            <ContentPresenter />
                        </Border>
                        <Border x:Name="Ring" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource FlowHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource FlowPressBorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Accent-colored inline token ("Spotify", "7:30 AM") used in sentences -->
    <Style x:Key="TokenButton" TargetType="Button">
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DsFocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource DsAccentTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="5" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <Border x:Name="Ring" CornerRadius="5" BorderThickness="2" BorderBrush="Transparent" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DsHoverBrush}" />
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource FlowHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource FlowPressBorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- List rows: soft hover, quiet selection with an accent marker (instead of a full accent fill) -->
    <Style x:Key="FlowListItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="{DynamicResource DsListItemMargin}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DsFocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <Border x:Name="Ring" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent" IsHitTestVisible="False" />
                        <Border x:Name="Marker" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,0" Visibility="Collapsed"
                                Background="{DynamicResource DsAccentBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DsHoverBrush}" />
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource FlowHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DsStrokeBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
