<ui:FluentWindow x:Class="AutomationPortal.App.Shell.QuickPanelWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AutomationPortal.App"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:ctl="clr-namespace:AutomationPortal.App.Controls"
                  xmlns:vm="clr-namespace:AutomationPortal.App.ViewModels"
                  Title="{local:Str QuickPanelWindow_AutomationPortalQuickPanel}" Width="620" SizeToContent="Height" MaxHeight="620"
                  ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="True"
                  WindowStartupLocation="Manual" WindowBackdropType="Acrylic" ExtendsContentIntoTitleBar="True"
                  FontFamily="{StaticResource FlowFont}" Foreground="{DynamicResource DsTextPrimaryBrush}" WindowCornerPreference="Round">
    <Grid x:Name="RootGrid" Margin="16,14,16,14">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="0" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,0,4,8">
            <TextBlock Text="{local:Str QuickPanelWindow_Pinned}" FontSize="{StaticResource DsFontSizePanelTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock x:Name="PausedNote" Text="{local:Str QuickPanelWindow_AutomationsPaused}" Foreground="{DynamicResource DsCautionBrush}" FontSize="{StaticResource DsFontSizeReadable}" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="420">
            <Grid>
                <ItemsControl x:Name="TileList" KeyboardNavigation.DirectionalNavigation="Contained">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ShortcutTileViewModel}">
                            <ctl:ShortcutTile Width="144" Height="108" ShowMoreButton="False" RunRequested="OnTileRun" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,24" MaxWidth="360">
                    <ui:SymbolIcon Symbol="Pin24" FontSize="34" Foreground="{DynamicResource DsTextSecondaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{local:Str QuickPanelWindow_NothingIsPinnedYet}" FontWeight="SemiBold" FontSize="{StaticResource DsFontSizePanelTitle}" HorizontalAlignment="Center" Margin="0,10,0,4" />
                    <TextBlock Text="{local:Str QuickPanelWindow_PinYourFavouriteShortcuts}" Style="{StaticResource SecondaryText}" TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <ui:Button Content="{local:Str QuickPanelWindow_OpenAutomationPortal}" AutomationProperties.Name="{local:Str QuickPanelWindow_OpenAutomationPortal_Name}" Icon="{ui:SymbolIcon Window24}" Click="OnOpenMain" />
            <ui:Button Content="{local:Str QuickPanelWindow_QuickRun}" AutomationProperties.Name="{local:Str QuickPanelWindow_QuickRun_Name}" Icon="{ui:SymbolIcon Search24}" Margin="8,0,0,0" Click="OnQuickRun" />
            <ui:Button Content="{local:Str QuickPanelWindow_Record}" AutomationProperties.Name="{local:Str QuickPanelWindow_Record_Name}" Icon="{ui:SymbolIcon Record24}" Margin="8,0,0,0" Click="OnRecord" ToolTip="{local:Str QuickPanelWindow_RecordANewShortcut_Tip}" />
            <ui:Button x:Name="PauseButton" AutomationProperties.Name="{local:Str QuickPanelWindow_PauseAutomations_Name}" Margin="8,0,0,0" Click="OnTogglePause" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
