  <PropertyGroup>
    <AssemblyName>AutomationPortal</AssemblyName>
    <IntermediateOutputPath>obj\Debug\</IntermediateOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>C:\Dev\Projects\AutomationPortal\.claude\worktrees\loc-triggers\src\AutomationPortal.App\obj\</MSBuildProjectExtensionsPath>
    <_TargetAssemblyProjectName>AutomationPortal.App</_TargetAssemblyProjectName>
    <RootNamespace>AutomationPortal.App</RootNamespace>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <OutputType>WinExe</OutputType>
    <RootNamespace>AutomationPortal.App</RootNamespace>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\automationportal.ico</ApplicationIcon>
    <NeutralLanguage>en</NeutralLanguage>
    <Product>Automation Portal</Product>
    <AssemblyTitle>Automation Portal</AssemblyTitle>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <!-- Crash reports: no global `using Sentry;`, no native crash handler (it would send past the consent gate and the redaction),
         and no module initializer that loads the SDK at startup. -->
    <SentryImplicitUsings>false</SentryImplicitUsings>
    <SentryNative>false</SentryNative>
    <SentryDisableSourceGenerator>true</SentryDisableSourceGenerator>
  </PropertyGroup>
