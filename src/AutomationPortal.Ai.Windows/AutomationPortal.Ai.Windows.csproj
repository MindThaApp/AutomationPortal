<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>AutomationPortal.Ai.Windows</RootNamespace>
    <NoWarn>$(NoWarn);CS1591;NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AutomationPortal.Core\AutomationPortal.Core.csproj" />
    <ProjectReference Include="..\AutomationPortal.Actions.Documents\AutomationPortal.Actions.Documents.csproj" />
    <!--
      Only the AI component of the Windows App SDK (not the whole metapackage): Phi Silica text and Windows AI imaging.
      Its MSBuild targets stay private to this library. If they flowed to the app they would switch the app to a self-contained or
      bootstrapper-initialised Windows App SDK, and the unpackaged build would then need (or ship) a runtime it never uses.
      The projection assemblies still flow to the app; they are only loaded when the Store build calls them
      (the runtime comes from the package dependency in AppxManifest.xml).
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="2.5.5" PrivateAssets="build;buildtransitive;native" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AutomationPortal.Ai.Windows.Tests" />
  </ItemGroup>
</Project>
