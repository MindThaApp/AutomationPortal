<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark theme tokens. Accent tokens (DsAccent*, DsSelection*, DsFocusRing) are set in code so they follow the Windows accent. -->

    <SolidColorBrush x:Key="DsTextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DsTextSecondaryBrush" Color="#C9FFFFFF" />
    <SolidColorBrush x:Key="DsTextTertiaryBrush" Color="#8CFFFFFF" />
    <SolidColorBrush x:Key="DsTextDisabledBrush" Color="#5CFFFFFF" />
    <SolidColorBrush x:Key="DsOnAccentTextBrush" Color="#000000" />

    <SolidColorBrush x:Key="DsAccentBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="DsAccentTextBrush" Color="#99EBFF" />
    <SolidColorBrush x:Key="DsFocusRingBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="DsSelectionFillBrush" Color="#384CC2FF" />
    <SolidColorBrush x:Key="DsSelectionHoverFillBrush" Color="#474CC2FF" />

    <SolidColorBrush x:Key="DsWindowBrush" Color="#202020" />
    <SolidColorBrush x:Key="DsLayerBrush" Color="#4D3A3A3A" />
    <SolidColorBrush x:Key="DsCardBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="DsFlyoutBrush" Color="#2C2C2C" />
    <SolidColorBrush x:Key="DsCanvasBrush" Color="#151515" />

    <SolidColorBrush x:Key="DsStrokeBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="DsStrokeLipBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="DsDividerBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="DsHoverBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="DsPressedBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="DsScrimBrush" Color="#4D000000" />

    <SolidColorBrush x:Key="DsCriticalBrush" Color="#FF99A4" />
    <SolidColorBrush x:Key="DsSuccessBrush" Color="#6CCB5F" />
    <SolidColorBrush x:Key="DsCautionBrush" Color="#FCE100" />
    <SolidColorBrush x:Key="DsCriticalBackgroundBrush" Color="#442726" />
    <SolidColorBrush x:Key="DsSuccessBackgroundBrush" Color="#393D1B" />
    <SolidColorBrush x:Key="DsCautionBackgroundBrush" Color="#433519" />
    <SolidColorBrush x:Key="DsFavoriteBrush" Color="#F5B301" />

    <!-- Overlays drawn on top of coloured tiles -->
    <SolidColorBrush x:Key="DsOnTileHoverBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="DsOnTilePressBrush" Color="#22000000" />
    <SolidColorBrush x:Key="DsOnTileFocusBrush" Color="#44FFFFFF" />
    <SolidColorBrush x:Key="DsRowHoverShadeBrush" Color="#22000000" />
    <SolidColorBrush x:Key="DsTileRim1Brush" Color="#08000000" />
    <SolidColorBrush x:Key="DsTileRim2Brush" Color="#0C000000" />
    <SolidColorBrush x:Key="DsTileRim3Brush" Color="#12000000" />
</ResourceDictionary>
