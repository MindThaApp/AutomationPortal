<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sw="clr-namespace:System.Windows;assembly=PresentationFramework">

    <!-- High contrast: every token is a system colour, surfaces are solid, hover and press are borders (see FlowHoverBorderBrush). -->

    <SolidColorBrush x:Key="DsTextPrimaryBrush" Color="{x:Static sw:SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="DsTextSecondaryBrush" Color="{x:Static sw:SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="DsTextTertiaryBrush" Color="{x:Static sw:SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="DsTextDisabledBrush" Color="{x:Static sw:SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="DsOnAccentTextBrush" Color="{x:Static sw:SystemColors.HighlightTextColor}" />

    <SolidColorBrush x:Key="DsAccentBrush" Color="{x:Static sw:SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="DsAccentTextBrush" Color="{x:Static sw:SystemColors.HotTrackColor}" />
    <SolidColorBrush x:Key="DsFocusRingBrush" Color="{x:Static sw:SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="DsSelectionFillBrush" Color="{x:Static sw:SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="DsSelectionHoverFillBrush" Color="{x:Static sw:SystemColors.HighlightColor}" />

    <SolidColorBrush x:Key="DsWindowBrush" Color="{x:Static sw:SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="DsLayerBrush" Color="{x:Static sw:SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="DsCardBrush" Color="{x:Static sw:SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="DsFlyoutBrush" Color="{x:Static sw:SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="DsCanvasBrush" Color="{x:Static sw:SystemColors.WindowColor}" />

    <SolidColorBrush x:Key="DsStrokeBrush" Color="{x:Static sw:SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="DsStrokeLipBrush" Color="{x:Static sw:SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="DsDividerBrush" Color="{x:Static sw:SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="DsHoverBrush" Color="Transparent" />
    <SolidColorBrush x:Key="DsPressedBrush" Color="Transparent" />
    <SolidColorBrush x:Key="DsScrimBrush" Color="{x:Static sw:SystemColors.WindowColor}" />

    <SolidColorBrush x:Key="DsCriticalBrush" Color="{x:Static sw:SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="DsSuccessBrush" Color="{x:Static sw:SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="DsCautionBrush" Color="{x:Static sw:SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="DsCriticalBackgroundBrush" Color="{x:Static sw:SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="DsSuccessBackgroundBrush" Color="{x:Static sw:SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="DsCautionBackgroundBrush" Color="{x:Static sw:SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="DsFavoriteBrush" Color="{x:Static sw:SystemColors.HighlightColor}" />

    <SolidColorBrush x:Key="DsOnTileHoverBrush" Color="Transparent" />
    <SolidColorBrush x:Key="DsOnTilePressBrush" Color="Transparent" />
    <SolidColorBrush x:Key="DsOnTileFocusBrush" Color="Transparent" />
    <SolidColorBrush x:Key="DsRowHoverShadeBrush" Color="Transparent" />
    <SolidColorBrush x:Key="DsTileRim1Brush" Color="Transparent" />
    <SolidColorBrush x:Key="DsTileRim2Brush" Color="Transparent" />
    <SolidColorBrush x:Key="DsTileRim3Brush" Color="Transparent" />
</ResourceDictionary>
