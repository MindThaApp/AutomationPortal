<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Shared design tokens that do not change with the theme. Colours that do change live in Tokens.Light / Tokens.Dark / Tokens.HighContrast. -->

    <!-- Category colours: solid squares with white glyphs -->
    <Color x:Key="DsCategoryBlueColor">#0F6CBD</Color>
    <Color x:Key="DsCategoryIndigoColor">#4F52D9</Color>
    <Color x:Key="DsCategoryVioletColor">#7A3FD1</Color>
    <Color x:Key="DsCategoryMagentaColor">#B82D74</Color>
    <Color x:Key="DsCategoryRedColor">#C93434</Color>
    <Color x:Key="DsCategoryOrangeColor">#C2570C</Color>
    <Color x:Key="DsCategoryAmberColor">#8F6200</Color>
    <Color x:Key="DsCategoryGreenColor">#1A7F37</Color>
    <Color x:Key="DsCategoryTealColor">#0B7A75</Color>
    <Color x:Key="DsCategorySlateColor">#52606D</Color>
    <SolidColorBrush x:Key="DsCategoryBlueBrush" Color="{StaticResource DsCategoryBlueColor}" />
    <SolidColorBrush x:Key="DsCategoryIndigoBrush" Color="{StaticResource DsCategoryIndigoColor}" />
    <SolidColorBrush x:Key="DsCategoryVioletBrush" Color="{StaticResource DsCategoryVioletColor}" />
    <SolidColorBrush x:Key="DsCategoryMagentaBrush" Color="{StaticResource DsCategoryMagentaColor}" />
    <SolidColorBrush x:Key="DsCategoryRedBrush" Color="{StaticResource DsCategoryRedColor}" />
    <SolidColorBrush x:Key="DsCategoryOrangeBrush" Color="{StaticResource DsCategoryOrangeColor}" />
    <SolidColorBrush x:Key="DsCategoryAmberBrush" Color="{StaticResource DsCategoryAmberColor}" />
    <SolidColorBrush x:Key="DsCategoryGreenBrush" Color="{StaticResource DsCategoryGreenColor}" />
    <SolidColorBrush x:Key="DsCategoryTealBrush" Color="{StaticResource DsCategoryTealColor}" />
    <SolidColorBrush x:Key="DsCategorySlateBrush" Color="{StaticResource DsCategorySlateColor}" />

    <!-- Radii -->
    <CornerRadius x:Key="DsRadiusControl">4</CornerRadius>
    <CornerRadius x:Key="DsRadiusCard">8</CornerRadius>
    <sys:Double x:Key="DsRadiusControlValue">4</sys:Double>
    <sys:Double x:Key="DsRadiusCardValue">8</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

    <!-- Spacing: 4 px base -->
    <sys:Double x:Key="DsSpace4">4</sys:Double>
    <sys:Double x:Key="DsSpace8">8</sys:Double>
    <sys:Double x:Key="DsSpace12">12</sys:Double>
    <sys:Double x:Key="DsSpace16">16</sys:Double>
    <sys:Double x:Key="DsSpace20">20</sys:Double>
    <sys:Double x:Key="DsSpace24">24</sys:Double>
    <sys:Double x:Key="DsSpace32">32</sys:Double>
    <sys:Double x:Key="DsSpace48">48</sys:Double>

    <!-- Density: paddings and row gaps (Standard values; Appearance.cs rewrites them for Compact and Comfortable) -->
    <Thickness x:Key="DsCardPadding">16,12,16,12</Thickness>
    <Thickness x:Key="DsCardGap">0,0,0,6</Thickness>
    <Thickness x:Key="DsListItemMargin">0,0,8,3</Thickness>

    <!-- Library tile size (Cards look; the Compact look is set from Appearance settings) -->
    <sys:Double x:Key="DsTileWidth">182</sys:Double>
    <sys:Double x:Key="DsTileHeight">156</sys:Double>
    <sys:Int32 x:Key="DsTileNameRow">1</sys:Int32>
    <sys:Int32 x:Key="DsTileNameColumn">0</sys:Int32>
    <sys:Int32 x:Key="DsTileNameColumnSpan">4</sys:Int32>
    <Thickness x:Key="DsTileNameMargin">0,6,0,0</Thickness>
    <VerticalAlignment x:Key="DsTileNameVerticalAlignment">Bottom</VerticalAlignment>
    <sys:Double x:Key="DsTileTitleLineHeight">18.2</sys:Double>
    <sys:Double x:Key="DsTileTitleMaxHeight">36.4</sys:Double>

    <!-- Type ramp (FontSize is a double in pixels). Readable is the 13 px floor for sentences. -->
    <sys:Double x:Key="DsFontSizeCaption">12</sys:Double>
    <sys:Double x:Key="DsFontSizeReadable">13</sys:Double>
    <sys:Double x:Key="DsFontSizeBody">14</sys:Double>
    <sys:Double x:Key="DsFontSizePanelTitle">16</sys:Double>
    <sys:Double x:Key="DsFontSizeSubtitle">20</sys:Double>
    <sys:Double x:Key="DsFontSizeTitle">28</sys:Double>

    <!-- Motion durations (nothing is longer than 333 ms) -->
    <Duration x:Key="DsMotionFast">0:0:0.083</Duration>
    <Duration x:Key="DsMotionNormal">0:0:0.167</Duration>
    <Duration x:Key="DsMotionNav">0:0:0.25</Duration>
    <Duration x:Key="DsMotionSlow">0:0:0.333</Duration>

    <!-- The single focus ring: 2 px line, 1 px gap, outside the control. -->
    <Style x:Key="DsFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" SnapsToDevicePixels="True" IsHitTestVisible="False"
                               RadiusX="5" RadiusY="5"
                               Stroke="{DynamicResource DsFocusRingBrush}" StrokeThickness="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
