<ui:FluentWindow x:Class="AutomationPortal.Editor.ShortcutEditorWindow"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:AutomationPortal.Editor"
                 xmlns:views="clr-namespace:AutomationPortal.Editor.UI"
                 Width="1220" Height="800" MinWidth="860" MinHeight="540"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 FontFamily="Segoe UI Variable Text, Segoe UI"
                 UseLayoutRounding="True" SnapsToDevicePixels="True">

    <ui:FluentWindow.Resources>
        <Style x:Key="FmTitleBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="4,2,4,2" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="Shortcut" />

        <!-- header -->
        <Grid Grid.Row="1" Margin="22,4,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="IconButton" Grid.Column="0" Padding="0" Margin="0,0,14,0" Width="52" Height="52" Background="Transparent" BorderThickness="0"
                    ToolTip="Change the icon and color" AutomationProperties.Name="Change icon and color" Cursor="Hand" Focusable="True">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Chip" CornerRadius="13" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="Hover" CornerRadius="13" Background="#22000000" Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <ui:SymbolIcon x:Name="HeaderIcon" Symbol="Flash24" FontSize="28" Foreground="White" />
            </Button>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBox x:Name="NameBox" Style="{StaticResource FmTitleBoxStyle}" MaxLength="80"
                         AutomationProperties.Name="Shortcut name" ToolTip="Click to rename" />
                <TextBlock x:Name="SaveText" FontSize="12" Margin="6,2,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button x:Name="RunButton" Appearance="Primary" Content="Run" Icon="{ui:SymbolIcon Play24}" Margin="0,0,1,0" Padding="16,7"
                           ToolTip="Run this shortcut (F5)" />
                <ui:Button x:Name="RunMenuButton" Appearance="Primary" Icon="{ui:SymbolIcon ChevronDown20}" Margin="0,0,8,0" Padding="8,7" Width="32"
                           ToolTip="More ways to run" AutomationProperties.Name="More ways to run" />
                <ui:Button x:Name="NextStepButton" Appearance="Primary" Content="Next step" Margin="0,0,8,0" Padding="14,7" Visibility="Collapsed"
                           ToolTip="Run this step, then pause before the next one" AutomationProperties.Name="Next step" />
                <ui:Button x:Name="RunToEndButton" Appearance="Secondary" Content="Run to end" Margin="0,0,8,0" Padding="14,7" Visibility="Collapsed"
                           ToolTip="Stop pausing and run the rest (still pauses at steps marked Pause here)" AutomationProperties.Name="Run to end" />
                <ui:Button x:Name="DetailsButton" Appearance="Secondary" Content="Details" Icon="{ui:SymbolIcon Info24}" Margin="0,0,8,0" Padding="14,7"
                           ToolTip="Name, hotkey, automations and more" />
                <ui:Button x:Name="MoreButton" Appearance="Transparent" Icon="{ui:SymbolIcon MoreHorizontal24}" Width="38" Height="36" Padding="0"
                           ToolTip="More" AutomationProperties.Name="More options" />
            </StackPanel>
        </Grid>

        <!-- body -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="340" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="LeftArea" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="ListArea" Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <ContentControl x:Name="WhenHost" Focusable="False" Margin="22,12,22,0" />
                        <ContentControl x:Name="NoteHost" Focusable="False" Margin="22,10,22,0" />
                    </StackPanel>
                    <ListBox x:Name="ActionList" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="22,14,22,0" Padding="0,0,0,12"
                             SelectionMode="Extended" AllowDrop="True"
                             ItemContainerStyle="{StaticResource FmRowItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             VirtualizingPanel.VirtualizationMode="Standard"
                             KeyboardNavigation.TabNavigation="Once"
                             AutomationProperties.Name="Actions in this shortcut">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <views:ActionRowView />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Canvas x:Name="DropOverlay" Grid.Row="1" IsHitTestVisible="False">
                        <Border x:Name="DropLine" Height="3" CornerRadius="2" Visibility="Collapsed"
                                Background="{DynamicResource AccentFillColorDefaultBrush}" />
                    </Canvas>

                    <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,0,40,60" MaxWidth="420" Visibility="Collapsed" />

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6,0,12">
                        <ui:Button x:Name="AddActionButton" Appearance="Secondary" Content="Add step" Icon="{ui:SymbolIcon Add24}" Padding="18,8"
                                   ToolTip="Search for an action to add at the end" />
                        <ui:Button x:Name="RecordButton" Appearance="Secondary" Content="Record what you do" Icon="{ui:SymbolIcon Record24}" Margin="8,0,0,0" Padding="14,8"
                                   ToolTip="Record clicks and typing into new steps" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>

                <ContentControl x:Name="DrawerHost" Grid.Row="1" Focusable="False" />
            </Grid>

            <Border Grid.Column="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

            <Border Grid.Column="2" Background="{DynamicResource LayerFillColorDefaultBrush}">
                <views:ActionPanelView x:Name="ActionPanel" />
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
