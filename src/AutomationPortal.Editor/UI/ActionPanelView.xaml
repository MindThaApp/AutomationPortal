<UserControl x:Class="AutomationPortal.Editor.UI.ActionPanelView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:AutomationPortal.Editor.UI"
             xmlns:vm="clr-namespace:AutomationPortal.Editor.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="14,14,14,8">
            <TextBlock Text="Actions" FontSize="16" FontWeight="SemiBold" Margin="2,0,0,10"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <ui:TextBox x:Name="SearchBox" PlaceholderText="Search actions" ClearButtonEnabled="True"
                        Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="Search actions" />
            <CheckBox x:Name="AdvancedToggle" Content="Show advanced steps" Margin="2,8,0,0"
                      IsChecked="{Binding ShowAdvanced, Mode=TwoWay}"
                      ToolTip="Also list steps for experts, such as running a command."
                      AutomationProperties.Name="Show advanced steps" />
        </StackPanel>

        <ListBox x:Name="PanelList" Grid.Row="1" ItemsSource="{Binding Items}" Style="{StaticResource FmPlainListStyle}"
                 ItemContainerStyleSelector="{x:Static local:ActionPanelView.StyleSelectorInstance}"
                 Padding="8,0,8,8" SelectionMode="Single" KeyboardNavigation.TabNavigation="Once">
            <ListBox.Resources>
                <BooleanToVisibilityConverter x:Key="BoolToVis" />
                <DataTemplate DataType="{x:Type vm:PanelHeader}">
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Margin="8,14,0,4"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </DataTemplate>

                <DataTemplate DataType="{x:Type vm:PanelCategory}">
                    <Grid Margin="6,6,8,6" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="28" Height="28" CornerRadius="7" Margin="0,0,10,0"
                                Background="{Binding ColorKey, Converter={x:Static local:PaletteBrushConverter.Instance}}">
                            <ui:SymbolIcon Symbol="{Binding Icon, Converter={x:Static local:IconNameConverter.Instance}}"
                                           FontSize="16" Foreground="{DynamicResource FlowChipForeground}" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Grid.Column="2" Text="{Binding Count}" VerticalAlignment="Center" FontSize="13" Margin="0,0,8,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <ui:SymbolIcon Grid.Column="3" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Symbol" Value="ChevronRight12" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Expanded}" Value="True">
                                            <Setter Property="Symbol" Value="ChevronDown12" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </Grid>
                </DataTemplate>

                <DataTemplate DataType="{x:Type vm:PanelAction}">
                    <Grid Margin="22,4,6,4" Background="Transparent"
                          ToolTip="{Binding Descriptor, Converter={x:Static local:HelpConverter.Instance}}"
                          ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="30000">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="26" Height="26" CornerRadius="6" Margin="0,0,10,0"
                                Background="{Binding ColorKey, Converter={x:Static local:PaletteBrushConverter.Instance}}">
                            <ui:SymbolIcon Symbol="{Binding Descriptor.Icon, Converter={x:Static local:IconNameConverter.Instance}}"
                                           FontSize="15" Foreground="{DynamicResource FlowChipForeground}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Descriptor.Title}" FontSize="14"
                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding OneLine}" FontSize="13" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowDescription}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Get" Tag="get" FontSize="12" Padding="8,1" Margin="0,0,4,0" Focusable="False" Cursor="Hand"
                                VerticalAlignment="Center" ToolTip="Power Plan Manager isn't installed. Get it from the Microsoft Store."
                                AutomationProperties.Name="Get Power Plan Manager from the Microsoft Store"
                                Visibility="{Binding ShowGet, Converter={StaticResource BoolToVis}}" />
                        <ToggleButton Grid.Column="3" x:Name="StarButton" IsChecked="{Binding IsFavourite, Mode=OneWay}"
                                      Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0" Focusable="False"
                                      ToolTip="Add to favourites" AutomationProperties.Name="Favourite" Cursor="Hand" Tag="star">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <ui:SymbolIcon x:Name="Glyph" Symbol="Star24" FontSize="16" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Glyph" Property="Filled" Value="True" />
                                            <Setter TargetName="Glyph" Property="Foreground" Value="#F5B301" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Glyph" Property="Foreground" Value="#F5B301" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </Grid>
                </DataTemplate>
            </ListBox.Resources>
        </ListBox>
    </Grid>
</UserControl>
