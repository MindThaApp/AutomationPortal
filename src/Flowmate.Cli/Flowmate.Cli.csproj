<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <AssemblyName>fm</AssemblyName>
    <RootNamespace>Flowmate.Cli</RootNamespace>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\Flowmate.App\Assets\flowmate.ico</ApplicationIcon>
    <ApplicationManifest>..\Flowmate.App\app.manifest</ApplicationManifest>
    <Product>Flow Mate</Product>
    <AssemblyTitle>Flow Mate command line</AssemblyTitle>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Flowmate.Core\Flowmate.Core.csproj" />
    <ProjectReference Include="..\Flowmate.Actions.Content\Flowmate.Actions.Content.csproj" />
    <ProjectReference Include="..\Flowmate.Actions.Windows\Flowmate.Actions.Windows.csproj" />
    <ProjectReference Include="..\Flowmate.Actions.Documents\Flowmate.Actions.Documents.csproj" />
    <ProjectReference Include="..\Flowmate.Triggers\Flowmate.Triggers.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Threading" />
    <Using Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <!-- Same clipboard and UI-thread code as the app; the CLI runs it on its own STA thread. -->
    <Compile Include="..\Flowmate.App\Services\ClipboardService.cs" Link="Shared\ClipboardService.cs" />
    <Compile Include="..\Flowmate.App\Services\DispatcherUiThread.cs" Link="Shared\DispatcherUiThread.cs" />
  </ItemGroup>
</Project>
