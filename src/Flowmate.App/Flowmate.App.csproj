<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Flowmate</AssemblyName>
    <RootNamespace>Flowmate.App</RootNamespace>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\flowmate.ico</ApplicationIcon>
    <NeutralLanguage>en</NeutralLanguage>
    <Product>Flow Mate</Product>
    <AssemblyTitle>Flow Mate</AssemblyTitle>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Flowmate.Core\Flowmate.Core.csproj" />
    <ProjectReference Include="..\Flowmate.Actions.Content\Flowmate.Actions.Content.csproj" />
    <ProjectReference Include="..\Flowmate.Actions.Windows\Flowmate.Actions.Windows.csproj" />
    <ProjectReference Include="..\Flowmate.Actions.Documents\Flowmate.Actions.Documents.csproj" />
    <ProjectReference Include="..\Flowmate.Triggers\Flowmate.Triggers.csproj" />
    <ProjectReference Include="..\Flowmate.Editor\Flowmate.Editor.csproj" />
    <ProjectReference Include="..\Flowmate.Ai.Windows\Flowmate.Ai.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\flowmate.ico" />
    <None Remove="Assets\flowmate.png" />
    <Resource Include="Assets\flowmate.png" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\gallery\**\*.*" Link="gallery\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Flowmate.App.Tests" />
  </ItemGroup>
</Project>
