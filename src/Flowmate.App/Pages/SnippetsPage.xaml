<UserControl x:Class="Flowmate.App.Pages.SnippetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Focusable="False" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="32,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Snippets" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Type a short code anywhere and Flow Mate swaps it for longer text." Style="{StaticResource SecondaryText}" Margin="2,2,0,0" />
            </StackPanel>
            <ui:Button Content="New Snippet" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnNewSnippet" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid x:Name="MainGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" MinWidth="260" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="SearchBox" PlaceholderText="Search snippets" Icon="{ui:SymbolIcon Search20}" TextChanged="OnFilterChanged" />
                        <ComboBox x:Name="FolderFilter" Grid.Column="1" Width="130" Margin="8,0,0,0" SelectionChanged="OnFolderFilterChanged" AutomationProperties.Name="Folder" />
                    </Grid>
                    <ListBox x:Name="SnippetList" Grid.Row="1" BorderThickness="0" Background="Transparent" SelectionChanged="OnSnippetSelected"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Snippets">
                        <ListBox.ItemContainerStyle><StaticResource ResourceKey="FlowListItem" /></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Abbreviation}" FontWeight="SemiBold" FontFamily="Consolas" FontSize="14" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Preview}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Folder}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{Binding FolderVisibility}" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" ToolTip="Turn this snippet on or off"
                                                     AutomationProperties.Name="Enabled" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- editor -->
                <Border Grid.Column="2" Style="{StaticResource SurfaceCard}" Padding="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="EditorPanel" Margin="22,18,22,22">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Short code" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,0,0,4" />
                                    <ui:TextBox x:Name="AbbrBox" PlaceholderText=";sig" FontFamily="Consolas" TextChanged="OnEditorChanged" AutomationProperties.Name="Short code" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Folder (optional)" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,0,0,4" />
                                    <ComboBox x:Name="FolderBox" IsEditable="True" Text="" AutomationProperties.Name="Folder" LostFocus="OnEditorChanged" SelectionChanged="OnEditorChangedSel" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="AbbrError" Visibility="Collapsed" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />

                            <TextBlock Text="Replace it with" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,16,0,4" />
                            <ui:TextBox x:Name="BodyBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="130" VerticalScrollBarVisibility="Auto"
                                        PlaceholderText="The text that should appear" TextChanged="OnEditorChanged" AutomationProperties.Name="Replacement text" />

                            <TextBlock Text="Add a placeholder" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,12,0,6" />
                            <WrapPanel>
                                <ui:Button Content="Date" Margin="0,0,6,6" Click="OnPlaceholder" Tag="{}{date}" ToolTip="Today's date" />
                                <ui:Button Content="Date format…" Margin="0,0,6,6" Click="OnDateFormat" ToolTip="Today's date in a format you choose, like yyyy-MM-dd" />
                                <ui:Button Content="Time" Margin="0,0,6,6" Click="OnPlaceholder" Tag="{}{time}" ToolTip="The current time" />
                                <ui:Button Content="Clipboard" Margin="0,0,6,6" Click="OnPlaceholder" Tag="{}{clipboard}" ToolTip="Whatever you last copied" />
                                <ui:Button Content="Cursor spot" Margin="0,0,6,6" Click="OnPlaceholder" Tag="{}{cursor}" ToolTip="Where the cursor lands after the text appears" />
                                <ui:Button Content="Ask me…" Margin="0,0,6,6" Click="OnFillIn" ToolTip="Flow Mate asks you a question each time and puts your answer here" />
                            </WrapPanel>

                            <TextBlock Text="Preview" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,10,0,4" />
                            <Border CornerRadius="8" Padding="12,10" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <TextBlock x:Name="PreviewText" TextWrapping="Wrap" MinHeight="20" />
                            </Border>

                            <ui:ToggleSwitch x:Name="MatchCaseToggle" Content="Match capital letters exactly" Margin="0,16,0,0" Click="OnEditorToggle" />
                            <TextBlock Text="When this is off, typing ;Hi gives a capital first letter and ;HI gives all capitals." Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,2,0,0" />

                            <ui:Button Content="Delete snippet" Icon="{ui:SymbolIcon Delete20}" Margin="0,20,0,0" Click="OnDelete" HorizontalAlignment="Left" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                <Border Width="84" Height="84" CornerRadius="24" HorizontalAlignment="Center" Background="{StaticResource FlowEmptyGradient}">
                    <ui:SymbolIcon Symbol="TextT24" FontSize="42" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Save yourself some typing" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,6" />
                <TextBlock Text="Make a short code like ;addr that turns into your full address whenever you type it. It works in any app." Style="{StaticResource SecondaryText}" TextAlignment="Center" />
                <ui:Button Content="Create your first snippet" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" HorizontalAlignment="Center" Margin="0,20,0,0" Click="OnNewSnippet" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
