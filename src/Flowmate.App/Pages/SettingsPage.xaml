<UserControl x:Class="Flowmate.App.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:Flowmate.App.Controls"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="CardDescription" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="SettingCard" TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,20,32,32" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />

            <!-- General -->
            <TextBlock Text="General" Style="{StaticResource SectionTitle}" />
            <ui:CardControl Style="{StaticResource SettingCard}" Icon="{ui:SymbolIcon WindowApps24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Start with Windows" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Open Flowmate quietly in the tray when you sign in, so your automations are always ready." Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="StartToggle" Click="OnStartToggle" AutomationProperties.Name="Start with Windows" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource SettingCard}" Icon="{ui:SymbolIcon ArrowMinimize24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Keep running in the tray" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="When you close the window, Flowmate keeps working in the background. Turn this off to quit when you close it." Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="TrayToggle" Click="OnTrayToggle" AutomationProperties.Name="Keep running in the tray" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource SettingCard}" Icon="{ui:SymbolIcon PaintBrush24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Theme" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Choose light or dark, or follow Windows." Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="ThemeBox" Width="160" SelectionChanged="OnThemeChanged" AutomationProperties.Name="Theme">
                    <ComboBoxItem Content="Same as Windows" Tag="System" />
                    <ComboBoxItem Content="Light" Tag="Light" />
                    <ComboBoxItem Content="Dark" Tag="Dark" />
                </ComboBox>
            </ui:CardControl>

            <!-- Keyboard -->
            <TextBlock Text="Keyboard" Style="{StaticResource SectionTitle}" />
            <ui:CardControl Style="{StaticResource SettingCard}" Icon="{ui:SymbolIcon Search24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Quick Run" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Press these keys anywhere to search for a shortcut and run it." Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ctl:HotkeyRecorderBox x:Name="QuickRunKey" Width="220" ValueChanged="OnQuickRunKey" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource SettingCard}" Icon="{ui:SymbolIcon ClipboardTextEdit24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Run on selected text" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Select some text in any app, press these keys, and pick a shortcut to run on it." Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ctl:HotkeyRecorderBox x:Name="SelectionKey" Width="220" ValueChanged="OnSelectionKey" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource SettingCard}" Icon="{ui:SymbolIcon Cursor24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Quick Panel at the mouse pointer" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Press these keys to pop up your pinned shortcuts right where the mouse is." Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ctl:HotkeyRecorderBox x:Name="PanelKey" Width="220" ValueChanged="OnPanelKey" />
            </ui:CardControl>

            <!-- Library -->
            <TextBlock Text="Library" Style="{StaticResource SectionTitle}" />
            <ui:CardControl Style="{StaticResource SettingCard}" Icon="{ui:SymbolIcon Folder24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Where your shortcuts are saved" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="LibraryPathText" Style="{StaticResource CardDescription}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="Open" Click="OnOpenLibrary" ToolTip="Show the folder in File Explorer" />
                    <ui:Button Content="Change…" Margin="8,0,0,0" Click="OnChangeLibrary" />
                </StackPanel>
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource SettingCard}" Icon="{ui:SymbolIcon Cloud24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Keep your shortcuts in OneDrive" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Copies your library into OneDrive so it stays in sync on all your PCs." Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="Move to OneDrive" Click="OnMoveToOneDrive" />
            </ui:CardControl>

            <!-- Actions -->
            <TextBlock Text="Actions" Style="{StaticResource SectionTitle}" />
            <ui:CardControl Style="{StaticResource SettingCard}" Icon="{ui:SymbolIcon Wrench24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Show advanced actions" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Adds power-user actions, like running commands, to the action list." Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="AdvancedToggle" Click="OnAdvancedToggle" AutomationProperties.Name="Show advanced actions" />
            </ui:CardControl>

            <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,6">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Sparkle24" FontSize="20" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="AI key" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Needed for the AI actions. Your key is stored encrypted on this PC and never shown again." Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </StackPanel>
                    <Grid Margin="34,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:PasswordBox x:Name="KeyBox" PlaceholderText="Paste your key here" AutomationProperties.Name="AI key" PasswordChanged="OnKeyChanged" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <ui:Button x:Name="SaveKeyButton" Content="Save" Appearance="Primary" Click="OnSaveKey" IsEnabled="False" />
                            <ui:Button x:Name="TestKeyButton" Content="Test key" Margin="8,0,0,0" Click="OnTestKey" />
                            <ui:Button x:Name="RemoveKeyButton" Content="Remove" Margin="8,0,0,0" Click="OnRemoveKey" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="34,8,0,0">
                        <ui:ProgressRing x:Name="KeyBusy" IsIndeterminate="True" Width="16" Height="16" Visibility="Collapsed" Margin="0,0,8,0" />
                        <TextBlock x:Name="KeyStatus" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <ui:CardControl Style="{StaticResource SettingCard}" Icon="{ui:SymbolIcon Brain24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="AI model" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="ModelDescription" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ModelFast" Content="Fast" GroupName="model" Margin="0,0,4,0" Click="OnModelChanged" Tag="Fast" MinWidth="70" />
                    <RadioButton x:Name="ModelSmart" Content="Smart" GroupName="model" Margin="0,0,4,0" Click="OnModelChanged" Tag="Smart" MinWidth="70" />
                    <RadioButton x:Name="ModelBest" Content="Best" GroupName="model" Click="OnModelChanged" Tag="Best" MinWidth="70" />
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource SettingCard}" Icon="{ui:SymbolIcon Phone24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Phone notifications topic" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Used by Send to My Phone. Pick a private, hard to guess name, then subscribe to it in the ntfy app on your phone." Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:TextBox x:Name="TopicBox" Width="240" PlaceholderText="for example: my-flowmate-7f3k" TextChanged="OnTopicChanged" />
            </ui:CardControl>

            <!-- Notifications -->
            <TextBlock Text="Notifications" Style="{StaticResource SectionTitle}" />
            <ui:CardControl Style="{StaticResource SettingCard}" Icon="{ui:SymbolIcon Alert24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Tell me when a keyboard shortcut finishes" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Shows a small notification after a shortcut you started with a key press has run." Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="NotifyToggle" Click="OnNotifyToggle" AutomationProperties.Name="Notify when keyboard shortcuts finish" />
            </ui:CardControl>

            <!-- Links -->
            <TextBlock Text="Links" Style="{StaticResource SectionTitle}" />
            <ui:CardControl Style="{StaticResource SettingCard}" Icon="{ui:SymbolIcon Link24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Allow flowmate:// links" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Lets web pages and other apps run your shortcuts without asking first. Leave this off unless you trust the links you click." Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="LinksToggle" Click="OnLinksToggle" AutomationProperties.Name="Allow flowmate links" />
            </ui:CardControl>

            <!-- About -->
            <TextBlock Text="About" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource SurfaceCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource FlowEmptyGradient}" Margin="0,0,14,0">
                            <ui:SymbolIcon Symbol="Flash24" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Flowmate" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock x:Name="VersionText" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Flowmate works on your PC. Nothing is sent anywhere unless a shortcut you run does it." Style="{StaticResource CardDescription}" Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <ui:Button Content="Open data folder" Icon="{ui:SymbolIcon FolderOpen24}" Click="OnOpenData" />
                        <ui:Button Content="Open log folder" Icon="{ui:SymbolIcon DocumentText24}" Margin="8,0,0,0" Click="OnOpenLogs" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
