<UserControl x:Class="Flowmate.App.Pages.GalleryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Focusable="False">
    <Grid Margin="32,20,8,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,24,12">
            <TextBlock Text="Gallery" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Ready-made shortcuts. Add the ones you like, then make them your own." Style="{StaticResource SecondaryText}" Margin="2,2,0,0" />
        </StackPanel>

        <Border x:Name="AddedBar" Grid.Row="1" Visibility="Collapsed" Margin="0,0,24,12" Padding="14,10" CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="22" Foreground="{DynamicResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock x:Name="AddedText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" />
                <ui:Button Grid.Column="2" Content="Show it" Click="OnShowAdded" Margin="12,0,0,0" />
                <ui:Button Grid.Column="3" Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss16}" Click="OnDismissAdded" Margin="4,0,0,0" ToolTip="Dismiss" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,16,24">
            <Grid>
                <StackPanel x:Name="Sections" />
                <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,60,24,0" MaxWidth="440">
                    <Border Width="84" Height="84" CornerRadius="24" HorizontalAlignment="Center" Background="{StaticResource FlowEmptyGradient}">
                        <ui:SymbolIcon Symbol="Library24" FontSize="42" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="No ready-made shortcuts yet" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,6" />
                    <TextBlock Text="Starter shortcuts will show up here when they are installed with Flowmate. In the meantime you can build your own, or open a .flowmate file you received from a friend."
                               Style="{StaticResource SecondaryText}" TextAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <ui:Button Content="Create a shortcut" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Click="OnCreate" />
                        <ui:Button Content="Open a .flowmate file…" Icon="{ui:SymbolIcon FolderOpen24}" Margin="10,0,0,0" Click="OnOpenFile" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
