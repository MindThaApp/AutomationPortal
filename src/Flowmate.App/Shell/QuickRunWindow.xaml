<ui:FluentWindow x:Class="Flowmate.App.Shell.QuickRunWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="Flowmate Quick Run" Width="680" SizeToContent="Height"
                  ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="True"
                  WindowStartupLocation="Manual" WindowBackdropType="Acrylic" ExtendsContentIntoTitleBar="True"
                  FontFamily="{StaticResource FlowFont}" WindowCornerPreference="Round">
    <Grid x:Name="RootGrid">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="0" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,18,20,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon Symbol="Search24" FontSize="24" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />

            <!-- Chip showing the shortcut chosen with Tab, or the selected text being used -->
            <Border x:Name="Chip" Grid.Column="1" Visibility="Collapsed" CornerRadius="6" Padding="10,4" Margin="0,0,10,0" VerticalAlignment="Center"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                <TextBlock x:Name="ChipText" FontSize="13" MaxWidth="260" TextTrimming="CharacterEllipsis" />
            </Border>

            <TextBox x:Name="Box" Grid.Column="2" FontSize="22" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                     Padding="0,4" FocusVisualStyle="{x:Null}" CaretBrush="{DynamicResource TextFillColorPrimaryBrush}"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                     TextChanged="OnTextChanged" PreviewKeyDown="OnBoxKeyDown" AutomationProperties.Name="Quick Run search" />
            <TextBlock x:Name="Placeholder" Grid.Column="2" Text="Type a shortcut name" FontSize="22" IsHitTestVisible="False" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="2,0,0,0" />
        </Grid>

        <Border Grid.Row="1" Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

        <Grid Grid.Row="2">
            <ListBox x:Name="ResultList" MaxHeight="450" BorderThickness="0" Background="Transparent" Margin="8,8,8,4" Focusable="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="Focusable" Value="False" />
                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnRowClick" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="10,8" MinHeight="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="10" Background="{Binding Brush}" Margin="0,0,14,0">
                                <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Subtitle}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Subtitle}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding ActionLabel}" FontSize="12" VerticalAlignment="Center" Margin="12,0,4,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="NoMatches" Text="Nothing found. Try another word." Visibility="Collapsed" Margin="24,18,24,18"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14" />
        </Grid>

        <Border Grid.Row="3" Padding="22,9" Background="{DynamicResource ControlFillColorSecondaryBrush}" Opacity="0.9">
            <TextBlock x:Name="Hints" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Border>
    </Grid>
</ui:FluentWindow>
