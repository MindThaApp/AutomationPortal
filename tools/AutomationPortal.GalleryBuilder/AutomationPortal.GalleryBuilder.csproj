    <ProjectReference Include="..\..\src\AutomationPortal.Actions.Content\AutomationPortal.Actions.Content.csproj" />
    <ProjectReference Include="..\..\src\AutomationPortal.Actions.Windows\AutomationPortal.Actions.Windows.csproj" />
    <ProjectReference Include="..\..\src\AutomationPortal.Actions.Documents\AutomationPortal.Actions.Documents.csproj" />
    <ProjectReference Include="..\..\src\AutomationPortal.Triggers\AutomationPortal.Triggers.csproj" />
  </ItemGroup>
