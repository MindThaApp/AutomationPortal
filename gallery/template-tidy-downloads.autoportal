{
  "format": "autoportal.shortcut",
  "version": 1,
  "shortcut": {
    "id": "5b0f3c1e-8a52-4d1b-9c64-2f7e1a9d3b01",
    "name": "Tidy Downloads",
    "description": "Moves files you downloaded a while ago into folders by type or date. Nothing is deleted, and Undo puts every file back.",
    "icon": "FolderArrowRight24",
    "color": "cyan",
    "sortOrder": 0,
    "pinned": false,
    "showInQuickRun": true,
    "showInSendTo": false,
    "acceptsInput": [],
    "whenNoInput": "continueWithNothing",
    "actions": [
      {
        "uid": "tidyFolder",
        "actionId": "file.getFolder",
        "parameters": {
          "folder": {
            "t": "choice",
            "v": "downloads"
          }
        },
        "disabled": false,
        "onError": {
          "mode": "stop",
          "retries": 2,
          "retryDelaySeconds": 1
        },
        "uiCollapsed": false
      },
      {
        "uid": "tidyList01",
        "actionId": "file.contents",
        "parameters": {
          "folder": {
            "t": "var",
            "ref": {
              "kind": "output",
              "uid": "tidyFolder"
            }
          },
          "include": {
            "t": "choice",
            "v": "files"
          },
          "subfolders": {
            "t": "bool",
            "v": false
          }
        },
        "disabled": false,
        "onError": {
          "mode": "stop",
          "retries": 2,
          "retryDelaySeconds": 1
        },
        "uiCollapsed": false
      },
      {
        "uid": "tidyOld001",
        "actionId": "file.filter",
        "parameters": {
          "files": {
            "t": "var",
            "ref": {
              "kind": "output",
              "uid": "tidyList01"
            }
          },
          "olderThanDays": {
            "t": "num",
            "v": 7
          }
        },
        "disabled": false,
        "onError": {
          "mode": "stop",
          "retries": 2,
          "retryDelaySeconds": 1
        },
        "uiCollapsed": false
      },
      {
        "uid": "tidyMove01",
        "actionId": "file.move",
        "parameters": {
          "files": {
            "t": "var",
            "ref": {
              "kind": "output",
              "uid": "tidyOld001"
            }
          },
          "folder": {
            "t": "var",
            "ref": {
              "kind": "output",
              "uid": "tidyFolder"
            }
          },
          "subfolder": {
            "t": "text",
            "parts": [
              "{kind}"
            ]
          },
          "ifExists": {
            "t": "choice",
            "v": "keep"
          }
        },
        "disabled": false,
        "onError": {
          "mode": "stop",
          "retries": 2,
          "retryDelaySeconds": 1
        },
        "uiCollapsed": false
      },
      {
        "uid": "tidyCount1",
        "actionId": "content.count",
        "parameters": {
          "input": {
            "t": "var",
            "ref": {
              "kind": "output",
              "uid": "tidyMove01"
            }
          },
          "what": {
            "t": "choice",
            "v": "items"
          }
        },
        "disabled": false,
        "onError": {
          "mode": "stop",
          "retries": 2,
          "retryDelaySeconds": 1
        },
        "uiCollapsed": false
      },
      {
        "uid": "tidyNote01",
        "actionId": "ui.notify",
        "parameters": {
          "title": {
            "t": "text",
            "parts": [
              "Tidied"
            ]
          },
          "body": {
            "t": "text",
            "parts": [
              "Moved ",
              {
                "var": {
                  "kind": "output",
                  "uid": "tidyCount1"
                }
              },
              " files into folders. Undo puts them back."
            ]
          }
        },
        "disabled": false,
        "onError": {
          "mode": "stop",
          "retries": 2,
          "retryDelaySeconds": 1
        },
        "uiCollapsed": false
      }
    ],
    "importQuestions": [
      {
        "actionUid": "tidyFolder",
        "parameterKey": "folder",
        "question": "Which folder?",
        "defaultValue": {
          "t": "choice",
          "v": "downloads"
        }
      },
      {
        "actionUid": "tidyMove01",
        "parameterKey": "subfolder",
        "question": "Into folders by",
        "defaultValue": {
          "t": "text",
          "parts": [
            "{kind}"
          ]
        }
      },
      {
        "actionUid": "tidyOld001",
        "parameterKey": "olderThanDays",
        "question": "Only files older than (days)",
        "defaultValue": {
          "t": "num",
          "v": 7
        }
      }
    ],
    "createdAt": "2026-11-16T12:00:00+00:00",
    "modifiedAt": "2026-11-16T12:00:00+00:00",
    "schemaVersion": 1
  }
}
