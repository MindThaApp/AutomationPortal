{
  "format": "flowmate.shortcut",
  "version": 1,
  "shortcut": {
    "id": "d47b7bfb-9a3f-50ac-54dd-c6f5ad704fac",
    "name": "Combine PDFs",
    "description": "Joins the PDFs you choose into one PDF, in the order you select them. Right-click PDFs and choose Send to.",
    "icon": "DocumentMultiple24",
    "color": "red",
    "sortOrder": 0,
    "pinned": false,
    "showInQuickRun": true,
    "showInSendTo": true,
    "acceptsInput": [
      "file"
    ],
    "whenNoInput": "askForFiles",
    "actions": [
      {
        "uid": "merge00001",
        "actionId": "pdf.merge",
        "parameters": {
          "files": {
            "t": "var",
            "ref": {
              "kind": "input"
            }
          },
          "name": {
            "t": "text",
            "parts": [
              "Combined"
            ]
          },
          "saveTo": {
            "t": "choice",
            "v": "next"
          }
        },
        "disabled": false,
        "onError": {
          "mode": "stop",
          "retries": 2,
          "retryDelaySeconds": 1
        },
        "uiCollapsed": false
      },
      {
        "uid": "reveal0001",
        "actionId": "app.reveal",
        "parameters": {
          "files": {
            "t": "var",
            "ref": {
              "kind": "output",
              "uid": "merge00001"
            }
          }
        },
        "disabled": false,
        "onError": {
          "mode": "stop",
          "retries": 2,
          "retryDelaySeconds": 1
        },
        "uiCollapsed": false
      }
    ],
    "importQuestions": [],
    "createdAt": "2026-10-02T12:00:00+00:00",
    "modifiedAt": "2026-10-02T12:00:00+00:00",
    "schemaVersion": 1
  }
}
