  "shortcut": {
    "id": "0cd43445-c995-632b-a172-3b8ce2473c0b",
    "name": "Text Expansion: My Address",
    "description": "Type ;addr anywhere and it turns into your address. Tip: add an automation \u0022When I type a phrase\u0022 with the phrase ;addr and turn on \u0022replace the phrase with this shortcut\u0027s text\u0022.",
    "icon": "Home24",
    "color": "teal",
    "sortOrder": 0,
    "pinned": false,
    "showInQuickRun": true,
    "showInSendTo": false,
    "acceptsInput": [],
    "whenNoInput": "continueWithNothing",
    "actions": [
      {
        "uid": "address001",
        "actionId": "content.text",
        "parameters": {
          "text": {
            "t": "text",
            "parts": [
              "123 Main Street\nSpringfield"
            ]
          }
        },
        "disabled": false,
        "onError": {
          "mode": "stop",
          "retries": 2,
          "retryDelaySeconds": 1
        },
        "uiCollapsed": false
      },
      {
        "uid": "output0001",
        "actionId": "flow.output",
        "parameters": {
          "output": {
            "t": "var",
            "ref": {
              "kind": "output",
              "uid": "address001"
            }
          }
        },
        "disabled": false,
        "onError": {
          "mode": "stop",
          "retries": 2,
          "retryDelaySeconds": 1
        },
        "uiCollapsed": false
      }
    ],
    "importQuestions": [
      {
        "actionUid": "address001",
        "parameterKey": "text",
        "question": "What text should ;addr type for you? (your address)",
        "defaultValue": {
          "t": "text",
          "parts": [
            "123 Main Street\nSpringfield"
          ]
        }
      }
