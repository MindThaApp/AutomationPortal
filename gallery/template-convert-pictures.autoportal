{
  "format": "autoportal.shortcut",
  "version": 1,
  "shortcut": {
    "id": "5b0f3c1e-8a52-4d1b-9c64-2f7e1a9d3b02",
    "name": "Convert Pictures",
    "description": "Saves the pictures you pick in another file type. Each one gets a new file next to it (photo.png makes photo.jpg); the originals are never changed, and a name that is taken gets (2).",
    "icon": "ImageArrowBack24",
    "color": "purple",
    "sortOrder": 0,
    "pinned": false,
    "showInQuickRun": true,
    "showInSendTo": true,
    "acceptsInput": [
      "image"
    ],
    "whenNoInput": "askForFiles",
    "actions": [
      {
        "uid": "convImg001",
        "actionId": "img.convert",
        "parameters": {
          "images": {
            "t": "var",
            "ref": {
              "kind": "input"
            }
          },
          "format": {
            "t": "choice",
            "v": "jpeg"
          },
          "quality": {
            "t": "num",
            "v": 90
          },
          "suffix": {
            "t": "text",
            "parts": [
              ""
            ]
          },
          "saveTo": {
            "t": "choice",
            "v": "next"
          }
        },
        "disabled": false,
        "onError": {
          "mode": "stop",
          "retries": 2,
          "retryDelaySeconds": 1
        },
        "uiCollapsed": false
      }
    ],
    "importQuestions": [
      {
        "actionUid": "convImg001",
        "parameterKey": "format",
        "question": "Convert to",
        "defaultValue": {
          "t": "choice",
          "v": "jpeg"
        }
      }
    ],
    "createdAt": "2026-11-16T12:00:00+00:00",
    "modifiedAt": "2026-11-16T12:00:00+00:00",
    "schemaVersion": 1
  }
