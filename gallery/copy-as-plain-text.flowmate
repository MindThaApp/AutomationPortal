{
  "format": "flowmate.shortcut",
  "version": 1,
  "shortcut": {
    "id": "d7914d2d-be0b-96ab-1aa4-bfa0607f92fe",
    "name": "Copy as Plain Text",
    "description": "Turns whatever you copied into plain text (no fonts, colours or links) and puts it back on the clipboard. Tip: give it a keyboard shortcut and paste without formatting anywhere.",
    "icon": "TextClearFormatting24",
    "color": "teal",
    "sortOrder": 0,
    "pinned": false,
    "showInQuickRun": true,
    "showInSendTo": false,
    "acceptsInput": [],
    "whenNoInput": "continueWithNothing",
    "actions": [
      {
        "uid": "getClip001",
        "actionId": "clip.get",
        "parameters": {
          "as": {
            "t": "choice",
            "v": "text"
          }
        },
        "disabled": false,
        "onError": {
          "mode": "stop",
          "retries": 2,
          "retryDelaySeconds": 1
        },
        "uiCollapsed": false
      },
      {
        "uid": "setClip001",
        "actionId": "clip.set",
        "parameters": {
          "content": {
            "t": "var",
            "ref": {
              "kind": "output",
              "uid": "getClip001"
            }
          }
        },
        "disabled": false,
        "onError": {
          "mode": "stop",
          "retries": 2,
          "retryDelaySeconds": 1
        },
        "uiCollapsed": false
      },
      {
        "uid": "notify001",
        "actionId": "ui.notify",
        "parameters": {
          "title": {
            "t": "text",
            "parts": [
              "Plain text copied"
            ]
          },
          "body": {
            "t": "text",
            "parts": [
              "The clipboard now has plain text only."
            ]
          }
        },
        "disabled": false,
        "onError": {
          "mode": "stop",
          "retries": 2,
          "retryDelaySeconds": 1
        },
        "uiCollapsed": false
      }
    ],
    "importQuestions": [],
    "createdAt": "2026-10-02T12:00:00+00:00",
    "modifiedAt": "2026-10-02T12:00:00+00:00",
    "schemaVersion": 1
  }
}
