    "name": "Grab Text from Screen",
    "description": "Drag a box around any text on screen (a picture, a video, a PDF that won\u0027t copy) and it lands on your clipboard, ready to paste. Tip: give it a keyboard shortcut.",
    "icon": "ScanText24",
    "color": "pink",
    "sortOrder": 0,
    "pinned": false,
    "showInQuickRun": true,
    "showInSendTo": false,
    "acceptsInput": [],
    "whenNoInput": "continueWithNothing",
    "actions": [
      {
        "uid": "grab000001",
        "actionId": "screen.grabText",
        "parameters": {
          "language": {
            "t": "choice",
            "v": "auto"
          }
        },
        "disabled": false,
        "onError": {
          "mode": "stop",
          "retries": 2,
          "retryDelaySeconds": 1
        },
        "uiCollapsed": false
      },
