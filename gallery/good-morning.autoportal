{
  "format": "autoportal.shortcut",
  "version": 1,
  "shortcut": {
    "id": "9d5a027e-6e8a-79fb-7271-b7794b183c1e",
    "name": "Good Morning",
    "description": "Tells you today\u0027s date and weather out loud, then opens your first apps. Tip: add an automation \u0022At a time of day\u0022 (weekday mornings) to run this for you.",
    "icon": "WeatherSunny24",
    "color": "orange",
    "sortOrder": 0,
    "pinned": false,
    "showInQuickRun": true,
    "showInSendTo": false,
    "acceptsInput": [],
    "whenNoInput": "continueWithNothing",
    "actions": [
      {
        "uid": "weather01",
        "actionId": "weather.current",
        "parameters": {
          "location": {
            "t": "text",
            "parts": [
              "London"
            ]
          },
          "units": {
            "t": "choice",
            "v": "auto"
          }
        },
        "disabled": false,
        "onError": {
          "mode": "stop",
          "retries": 2,
          "retryDelaySeconds": 1
        },
        "uiCollapsed": false
      },
      {
        "uid": "today0001",
        "actionId": "date.current",
        "parameters": {},
        "disabled": false,
        "onError": {
          "mode": "stop",
          "retries": 2,
          "retryDelaySeconds": 1
        },
        "uiCollapsed": false
      },
      {
        "uid": "dayName01",
        "actionId": "date.format",
        "parameters": {
          "date": {
            "t": "var",
            "ref": {
              "kind": "output",
              "uid": "today0001"
            }
          },
          "format": {
            "t": "choice",
            "v": "custom"
          },
          "custom": {
            "t": "text",
            "parts": [
              "dddd, d MMMM"
            ]
          }
        },
        "disabled": false,
        "onError": {
          "mode": "stop",
          "retries": 2,
          "retryDelaySeconds": 1
        },
        "uiCollapsed": false
      },
      {
        "uid": "greeting1",
        "actionId": "content.text",
        "parameters": {
          "text": {
            "t": "text",
            "parts": [
              "Good morning! It\u0027s ",
              {
                "var": {
                  "kind": "output",
                  "uid": "dayName01"
                }
              },
              ". Right now it\u0027s ",
              {
                "var": {
                  "kind": "output",
                  "uid": "weather01",
                  "prop": "key:Summary"
                }
              },
              ", with a high of ",
              {
                "var": {
                  "kind": "output",
                  "uid": "weather01",
                  "prop": "key:High"
                }
              },
              " and a low of ",
              {
                "var": {
                  "kind": "output",
                  "uid": "weather01",
                  "prop": "key:Low"
                }
              },
              "."
            ]
          }
        },
        "disabled": false,
        "onError": {
          "mode": "stop",
          "retries": 2,
          "retryDelaySeconds": 1
        },
        "uiCollapsed": false
      },
      {
        "uid": "notify001",
        "actionId": "ui.notify",
        "parameters": {
          "title": {
            "t": "text",
            "parts": [
              "Good Morning"
            ]
          },
          "body": {
            "t": "var",
            "ref": {
              "kind": "output",
              "uid": "greeting1"
            }
          }
        },
        "disabled": false,
        "onError": {
          "mode": "stop",
          "retries": 2,
          "retryDelaySeconds": 1
        },
        "uiCollapsed": false
      },
      {
        "uid": "speak0001",
        "actionId": "media.speak",
        "parameters": {
          "text": {
            "t": "var",
            "ref": {
              "kind": "output",
              "uid": "greeting1"
            }
          }
        },
        "disabled": false,
        "onError": {
          "mode": "stop",
          "retries": 2,
          "retryDelaySeconds": 1
        },
        "uiCollapsed": false
      },
      {
        "uid": "openApp01",
        "actionId": "app.open",
        "parameters": {
          "app": {
            "t": "app",
            "id": "Microsoft Edge",
            "name": "Microsoft Edge"
          }
        },
        "disabled": false,
        "onError": {
          "mode": "continue",
          "retries": 2,
          "retryDelaySeconds": 1
        },
        "uiCollapsed": false
      },
      {
        "uid": "openApp02",
        "actionId": "app.open",
        "parameters": {
          "app": {
            "t": "app",
            "id": "Outlook",
            "name": "Outlook"
          }
        },
        "disabled": false,
        "onError": {
          "mode": "continue",
          "retries": 2,
          "retryDelaySeconds": 1
        },
        "uiCollapsed": false
      }
    ],
    "importQuestions": [
      {
        "actionUid": "weather01",
        "parameterKey": "location",
        "question": "Which city should I check the weather for?",
        "defaultValue": {
          "t": "text",
          "parts": [
            "London"
          ]
        }
      },
      {
        "actionUid": "openApp01",
        "parameterKey": "app",
        "question": "Which app do you want to open first each morning?",
        "defaultValue": {
          "t": "app",
          "id": "Microsoft Edge",
          "name": "Microsoft Edge"
        }
      },
      {
        "actionUid": "openApp02",
        "parameterKey": "app",
        "question": "And which app second?",
        "defaultValue": {
          "t": "app",
          "id": "Outlook",
          "name": "Outlook"
        }
      }
    ],
    "createdAt": "2026-10-02T12:00:00+00:00",
    "modifiedAt": "2026-10-02T12:00:00+00:00",
    "schemaVersion": 1
  }
