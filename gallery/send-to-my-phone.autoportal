{
  "format": "flowmate.shortcut",
  "version": 1,
  "shortcut": {
    "id": "b0f824af-9f4c-314e-070a-f42b8494ab65",
    "name": "Send to My Phone",
    "description": "Sends text or a link to your phone as a notification, using the free ntfy app. Install ntfy on your phone and subscribe to the same topic name. Uses what you give it, or the clipboard.",
    "icon": "Phone24",
    "color": "green",
    "sortOrder": 0,
    "pinned": false,
    "showInQuickRun": true,
    "showInSendTo": false,
    "acceptsInput": [
      "text",
      "url"
    ],
    "whenNoInput": "useClipboard",
    "actions": [
      {
        "uid": "phone00001",
        "actionId": "share.phone",
        "parameters": {
          "message": {
            "t": "var",
            "ref": {
              "kind": "input"
            }
          },
          "title": {
            "t": "text",
            "parts": [
              "From my PC"
            ]
          },
          "topic": {
            "t": "text",
            "parts": [
              "my-flowmate-topic"
            ]
          },
          "priority": {
            "t": "choice",
            "v": "default"
          }
        },
        "disabled": false,
        "onError": {
          "mode": "stop",
          "retries": 2,
          "retryDelaySeconds": 1
        },
        "uiCollapsed": false
      },
      {
        "uid": "notify001",
        "actionId": "ui.notify",
        "parameters": {
          "title": {
            "t": "text",
            "parts": [
              "Sent"
            ]
          },
          "body": {
            "t": "text",
            "parts": [
              "It\u0027s on its way to your phone."
            ]
          }
        },
        "disabled": false,
        "onError": {
          "mode": "stop",
          "retries": 2,
          "retryDelaySeconds": 1
        },
        "uiCollapsed": false
      }
    ],
    "importQuestions": [
      {
        "actionUid": "phone00001",
        "parameterKey": "topic",
        "question": "What is your ntfy topic name? Pick something hard to guess.",
        "defaultValue": {
          "t": "text",
          "parts": [
            "my-flowmate-topic"
          ]
        }
      }
    ],
    "createdAt": "2026-10-02T12:00:00+00:00",
    "modifiedAt": "2026-10-02T12:00:00+00:00",
    "schemaVersion": 1
  }
}
