    "id": "546c9906-dd59-9517-4703-0d790e7c58ad",
    "name": "Fix My Writing",
    "description": "Fixes spelling and grammar in the text you copied, keeping your own words. The corrected text goes back on the clipboard. Uses your default AI provider (set it up in Settings).",
    "icon": "TextEditStyle24",
    "color": "purple",
    "sortOrder": 0,
    "pinned": false,
    "showInQuickRun": true,
    "showInSendTo": false,
    "acceptsInput": [
      "text"
    ],
    "whenNoInput": "useClipboard",
    "actions": [
      {
        "uid": "rewrite001",
        "actionId": "ai.rewrite",
        "parameters": {
          "text": {
            "t": "var",
            "ref": {
              "kind": "input"
            }
          },
          "style": {
            "t": "choice",
            "v": "proofread"
          },
          "provider": {
            "t": "choice",
            "v": "default"
          }
        },
        "disabled": false,
        "onError": {
          "mode": "stop",
          "retries": 2,
          "retryDelaySeconds": 1
        },
        "uiCollapsed": false
      },
      {
        "uid": "setClip001",
        "actionId": "clip.set",
        "parameters": {
          "content": {
            "t": "var",
