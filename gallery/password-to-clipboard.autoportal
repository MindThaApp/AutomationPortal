{
  "format": "autoportal.shortcut",
  "version": 1,
  "shortcut": {
    "id": "b813d718-b455-eefb-1571-42c22e663919",
    "name": "Password to Clipboard",
    "description": "Makes a strong random password and copies it. It\u0027s wiped from the clipboard after a minute, so it doesn\u0027t linger.",
    "icon": "Key24",
    "color": "graphite",
    "sortOrder": 0,
    "pinned": false,
    "showInQuickRun": true,
    "showInSendTo": false,
    "acceptsInput": [],
    "whenNoInput": "continueWithNothing",
    "actions": [
      {
        "uid": "password01",
        "actionId": "text.password",
        "parameters": {
          "style": {
            "t": "choice",
            "v": "characters"
          },
          "length": {
            "t": "num",
            "v": 20
          },
          "symbols": {
            "t": "bool",
            "v": true
          },
          "digits": {
            "t": "bool",
            "v": true
          }
        },
        "disabled": false,
        "onError": {
          "mode": "stop",
          "retries": 2,
          "retryDelaySeconds": 1
        },
        "uiCollapsed": false
      },
      {
        "uid": "copy000001",
        "actionId": "clip.set",
        "parameters": {
          "content": {
            "t": "var",
            "ref": {
              "kind": "output",
              "uid": "password01"
            }
          },
          "clearAfter": {
            "t": "duration",
            "seconds": 60
          }
        },
        "disabled": false,
        "onError": {
          "mode": "stop",
          "retries": 2,
          "retryDelaySeconds": 1
        },
        "uiCollapsed": false
      },
      {
        "uid": "notify001",
        "actionId": "ui.notify",
        "parameters": {
          "title": {
            "t": "text",
            "parts": [
              "Password ready"
            ]
          },
          "body": {
            "t": "text",
            "parts": [
              "Your new password is on the clipboard. It will be cleared in 60 seconds."
            ]
          }
        },
        "disabled": false,
        "onError": {
          "mode": "stop",
          "retries": 2,
          "retryDelaySeconds": 1
        },
        "uiCollapsed": false
      }
    ],
    "importQuestions": [
      {
        "actionUid": "password01",
        "parameterKey": "length",
        "question": "How long should the password be?",
        "defaultValue": {
          "t": "num",
          "v": 20
        }
      }
    ],
