  "shortcut": {
    "id": "4bd3d61d-7eb6-c0cb-6a05-15d43a483634",
    "name": "Tidy Desktop",
    "description": "Moves pictures, PDFs, documents and zip files off your Desktop into a \u0022Tidy Desktop\u0022 folder, sorted by type. Shortcuts and programs stay where they are. It asks first.",
    "icon": "DesktopCheckmark24",
    "color": "gray",
    "sortOrder": 0,
    "pinned": false,
    "showInQuickRun": true,
    "showInSendTo": false,
    "acceptsInput": [],
    "whenNoInput": "continueWithNothing",
    "actions": [
      {
        "uid": "confirm001",
        "actionId": "ui.alert",
        "parameters": {
          "title": {
            "t": "text",
            "parts": [
              "Tidy Desktop"
            ]
          },
          "message": {
            "t": "text",
            "parts": [
              "This moves pictures, PDFs, documents and zip files from your Desktop into a Tidy Desktop folder. Continue?"
            ]
          },
          "showCancel": {
            "t": "bool",
            "v": true
          }
        },
        "disabled": false,
        "onError": {
          "mode": "stop",
          "retries": 2,
          "retryDelaySeconds": 1
        },
        "uiCollapsed": false
      },
      {
        "uid": "desktop001",
        "actionId": "file.getFolder",
        "parameters": {
          "folder": {
            "t": "choice",
            "v": "desktop"
          }
        },
        "disabled": false,
        "onError": {
          "mode": "stop",
          "retries": 2,
          "retryDelaySeconds": 1
        },
        "uiCollapsed": false
      },
      {
