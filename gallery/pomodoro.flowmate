  "shortcut": {
    "id": "e57ab50b-a511-e7d9-b133-c5b5d4c8b63e",
    "name": "Pomodoro",
    "description": "Four rounds of 25 minutes of focus followed by a 5-minute break, with a notification at each step. Leave it running in the background.",
    "icon": "Timer24",
    "color": "red",
    "sortOrder": 0,
    "pinned": false,
    "showInQuickRun": true,
    "showInSendTo": false,
    "acceptsInput": [],
    "whenNoInput": "continueWithNothing",
    "actions": [
      {
        "uid": "6c314593e9",
        "actionId": "flow.repeat",
        "parameters": {
          "count": {
            "t": "num",
            "v": 4
          }
        },
        "disabled": false,
        "onError": {
          "mode": "stop",
          "retries": 2,
          "retryDelaySeconds": 1
        },
        "flow": {
          "groupId": "f291b587",
          "role": "start"
        },
        "uiCollapsed": false
      },
      {
