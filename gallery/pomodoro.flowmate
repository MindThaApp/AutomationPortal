        "actionId": "ui.notify",
        "parameters": {
          "title": {
            "t": "text",
            "parts": [
              "Focus time"
            ]
          },
          "body": {
            "t": "text",
            "parts": [
              "Round ",
              {
                "var": {
                  "kind": "repeatIndex"
                }
              },
              " of 4. Focus for 25 minutes."
            ]
          }
        },
        "disabled": false,
        "onError": {
          "mode": "stop",
          "retries": 2,
          "retryDelaySeconds": 1
        },
        "uiCollapsed": false
      },
