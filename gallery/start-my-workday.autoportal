    "name": "Start My Workday",
    "description": "Opens your email and chat apps and your most-used websites to begin the day. Choose your own when you add it. Tip: add an automation \u0022When I sign in\u0022 to run this for you.",
    "icon": "Briefcase24",
    "color": "orange",
    "sortOrder": 0,
    "pinned": false,
    "showInQuickRun": true,
    "showInSendTo": false,
    "acceptsInput": [],
    "whenNoInput": "continueWithNothing",
